<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="Zitie.Avalonia.Themes.Tokens.ZitiePrintTokens"
                    xmlns:rendering="using:Zitie.Avalonia.Rendering">
    <!-- 打印令牌：面向黑白打印机的完整渲染外观（PDF/PNG 导出使用）。
         不合入应用主题（Index.axaml），仅供 SheetRenderThemes.Print 按需加载。 -->

    <!-- 格线 -->
    <Color x:Key="ZitieGridSolidColor">#B04A3F</Color>
    <Color x:Key="ZitieGridDashColor">#D28C83</Color>
    <x:Double x:Key="ZitieGridSolidStrokePt">1.1</x:Double>
    <x:Double x:Key="ZitieGridDashStrokePt">0.7</x:Double>

    <!-- 文字 -->
    <Color x:Key="ZitieModelGlyphColor">#000000</Color>
    <Color x:Key="ZitieTraceGlyphColor">#DF9C93</Color>
    <Color x:Key="ZitieTitleColor">#000000</Color>
    <Color x:Key="ZitieFieldColor">#404040</Color>
    <Color x:Key="ZitieFooterColor">#909090</Color>
    <Color x:Key="ZitiePinyinColor">#505050</Color>

    <!-- 页面装饰边框 -->
    <Color x:Key="ZitieFrameColor">#8A8A8A</Color>
    <Color x:Key="ZitieFrameInnerColor">#C8C8C8</Color>

    <rendering:SheetRenderTheme x:Key="ZitiePrintRenderTheme"
                                GridSolidColor="{StaticResource ZitieGridSolidColor}"
                                GridDashColor="{StaticResource ZitieGridDashColor}"
                                GridSolidStrokePt="{StaticResource ZitieGridSolidStrokePt}"
                                GridDashStrokePt="{StaticResource ZitieGridDashStrokePt}"
                                ModelGlyphColor="{StaticResource ZitieModelGlyphColor}"
                                TraceGlyphColor="{StaticResource ZitieTraceGlyphColor}"
                                TitleColor="{StaticResource ZitieTitleColor}"
                                FieldColor="{StaticResource ZitieFieldColor}"
                                FooterColor="{StaticResource ZitieFooterColor}"
                                PinyinColor="{StaticResource ZitiePinyinColor}"
                                FrameColor="{StaticResource ZitieFrameColor}"
                                FrameInnerColor="{StaticResource ZitieFrameInnerColor}" />
</ResourceDictionary>
