<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Zitie.Desktop.ViewModels"
             xmlns:zitie="using:Zitie.Avalonia.Controls"
             x:Class="Zitie.Desktop.Views.SheetEditorView"
             x:DataType="vm:SheetEditorViewModel">
    <DockPanel>
        <!-- 工具栏 -->
        <Border DockPanel.Dock="Top" Classes="toolbar">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="← 返回" Command="{Binding GoBackCommand}" />
                <Separator Margin="4,0" />
                <Button Content="导出 PDF" Click="ExportPdfButton_OnClick" Classes="primary" />
                <Button Content="导出 PNG" Click="ExportPngButton_OnClick" />
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="300,*">
            <!-- 左侧配置面板 -->
            <Border Grid.Column="0" Classes="config-panel">
                <ScrollViewer>
                    <StackPanel Spacing="14">
                        <TextBlock Text="文本内容" Classes="section-title" />
                        <TextBox Text="{Binding InputText}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="140"
                                 VerticalContentAlignment="Top"
                                 PlaceholderText="输入要练习的字，逐字生成练习组" />

                        <TextBlock Text="从文本库选择" Classes="section-title" />
                        <ComboBox ItemsSource="{Binding TextEntries}"
                                  SelectedIndex="{Binding TextEntryIndex}"
                                  PlaceholderText="选择诗词 / 蒙学 / 名言 / 英文" />

                        <TextBlock Text="页眉标题" Classes="section-title" />
                        <TextBox Text="{Binding Title}" PlaceholderText="留空则不显示标题行" />

                        <TextBlock Text="格子类型" Classes="section-title" />
                        <ComboBox SelectedIndex="{Binding GridKindIndex}">
                            <ComboBoxItem Content="米字格" />
                            <ComboBoxItem Content="田字格" />
                            <ComboBoxItem Content="回宫格" />
                            <ComboBoxItem Content="方格" />
                            <ComboBoxItem Content="英文四线三格" />
                            <ComboBoxItem Content="九宫格" />
                            <ComboBoxItem Content="拼音四线格" />
                        </ComboBox>

                        <TextBlock Text="格子大小" Classes="section-title" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Slider Minimum="8" Maximum="60"
                                    Value="{Binding GridSizeMm}"
                                    Width="200"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="{Binding GridSizeMm, StringFormat={}{0:0} mm}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="练习模式" Classes="section-title" />
                        <ComboBox SelectedIndex="{Binding PracticeModeIndex}">
                            <ComboBoxItem Content="描红：范字 + 描红 + 空格" />
                            <ComboBoxItem Content="临摹：范字 + 空格" />
                        </ComboBox>

                        <CheckBox Content="空心双钩字（范字描轮廓，供填墨）"
                                  IsChecked="{Binding HollowGlyph}" />

                        <TextBlock Text="描红字颜色" Classes="section-title" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Border Width="22" Height="22" CornerRadius="4"
                                    Background="{Binding TraceColor}"
                                    BorderBrush="#888888" BorderThickness="1"
                                    VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding TraceColor}"
                                     PlaceholderText="#DF9C93 或 red" />
                            <TextBlock Grid.Column="2"
                                       Text="浅色适合打印后手描"
                                       FontSize="11" Foreground="#777777"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="每字格数" Classes="section-title" />
                        <ComboBox ItemsSource="{Binding RepeatsChoices}"
                                  SelectedIndex="{Binding RepeatsIndex}" />

                        <CheckBox Content="按词分组（词内字符连续，不拆行）"
                                  IsChecked="{Binding GroupByWord}" />
                        <CheckBox Content="竖排版式（从右到左，传统书法帖式）"
                                  IsChecked="{Binding IsVertical}" />
                        <CheckBox Content="题头显示作者（朝代 · 作者）"
                                  IsChecked="{Binding ShowPoemHeader}" />
                        <CheckBox Content="页面装饰边框" IsChecked="{Binding FrameBorder}" />

                        <TextBlock Text="纸张模板" Classes="section-title" />
                        <ComboBox SelectedIndex="{Binding BackgroundIndex}">
                            <ComboBoxItem Content="白底（无底纹）" />
                            <ComboBoxItem Content="红格纸（淡红横线）" />
                            <ComboBoxItem Content="信纸（淡蓝横线）" />
                        </ComboBox>

                        <CheckBox Content="标注拼音" IsChecked="{Binding ShowPinyin}" />
                        <CheckBox Content="只看拼音（隐藏范字，看拼音写词语）"
                                  IsChecked="{Binding PinyinOnly}"
                                  IsEnabled="{Binding ShowPinyin}" />

                        <TextBlock Text="显示缩放" Classes="section-title" />
                        <Slider Minimum="0.5" Maximum="2"
                                TickFrequency="0.25" TickPlacement="BottomRight"
                                Value="{Binding Zoom}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右侧预览 -->
            <Grid Grid.Column="1" RowDefinitions="*,Auto" Margin="12,12,12,6">
                <zitie:ZitiePreview Grid.Row="0"
                                   Spec="{Binding Spec}"
                                   Pages="{Binding Pages}"
                                   PageIndex="{Binding PageIndex}"
                                   Zoom="{Binding Zoom}" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Center" Margin="0,8">
                    <Button Content="上一页" Command="{Binding PreviousPageCommand}" />
                    <TextBlock Text="{Binding PageIndicator}" VerticalAlignment="Center" />
                    <Button Content="下一页" Command="{Binding NextPageCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
