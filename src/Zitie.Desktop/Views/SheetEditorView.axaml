<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:vm="using:Zitie.Desktop.ViewModels"
             xmlns:services="using:Zitie.Desktop.Services"
             xmlns:zitie="using:Zitie.Avalonia.Controls"
             x:Class="Zitie.Desktop.Views.SheetEditorView"
             x:DataType="vm:SheetEditorViewModel"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="toolbar">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="返回" Command="{Binding GoBackCommand}" />
                    <Separator Margin="4,0" />
                    <Button Content="打开" Click="OpenDocumentButton_OnClick" />
                    <Button Content="保存" Click="SaveDocumentButton_OnClick" IsEnabled="{Binding IsDirty}" />
                    <Button Content="另存" Click="SaveAsDocumentButton_OnClick" />
                    <Button Content="保存模板" Click="SaveTemplateButton_OnClick" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Button Content="导出 PDF" Click="ExportPdfButton_OnClick" Classes="primary" />
                    <Button Content="导出 PNG" Click="ExportPngButton_OnClick" />
                    <Button Content="批量 PNG" Click="ExportPngsButton_OnClick" />
                    <Button Content="打印" Click="PrintButton_OnClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Classes="status-bar">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding StatusMessage}" Classes="status-text" />
                <TextBlock Grid.Column="1"
                           Text="{Binding DocumentPath, StringFormat={}文档：{0}}"
                           Classes="status-path"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Grid ColumnDefinitions="320,*">
            <Border Grid.Column="0" Classes="config-panel">
                <ScrollViewer>
                    <StackPanel Spacing="10">
                        <Border Classes="settings-section">
                            <StackPanel Spacing="8">
                                <TextBlock Text="内容与页头" Classes="settings-section-title" />
                                <TextBlock Text="练习文本" Classes="section-title" />
                                <TextBox Text="{Binding InputText}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="116"
                                         VerticalContentAlignment="Top"
                                         PlaceholderText="输入要练习的字，逐字生成练习组" />
                                <TextBlock Text="从文本库选择" Classes="section-title" />
                                <ComboBox ItemsSource="{Binding TextEntries}"
                                          SelectedIndex="{Binding TextEntryIndex}"
                                          PlaceholderText="选择诗词 / 蒙学 / 名言 / 英文">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="services:TextEntry">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding Title}" />
                                                <TextBlock Classes="muted-text"
                                                           Text="{Binding Category, StringFormat={}分类：{0}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <TextBlock Text="标题" Classes="section-title" />
                                        <TextBox Text="{Binding Title}" PlaceholderText="留空则不显示" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="页头样式" Classes="section-title" />
                                        <ComboBox ItemsSource="{Binding HeaderPresetChoices}"
                                                  SelectedIndex="{Binding HeaderPresetIndex}" />
                                    </StackPanel>
                                </Grid>
                                <TextBox Text="{Binding HeaderTextTemplate}"
                                         IsEnabled="{Binding IsCustomHeader}"
                                         PlaceholderText="自定义页头：姓名_班级---年_月_日" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <TextBlock Text="朝代" Classes="section-title" />
                                        <TextBox Text="{Binding Dynasty}"
                                                 IsEnabled="{Binding IsPoemHeader}"
                                                 PlaceholderText="唐" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="作者" Classes="section-title" />
                                        <TextBox Text="{Binding Author}"
                                                 IsEnabled="{Binding IsPoemHeader}"
                                                 PlaceholderText="李白" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox Content="题头显示作者（朝代 · 作者）"
                                          IsChecked="{Binding ShowPoemHeader}" />
                            </StackPanel>
                        </Border>

                        <Border Classes="settings-section">
                            <StackPanel Spacing="8">
                                <TextBlock Text="纸张与版式" Classes="settings-section-title" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <TextBlock Text="纸张规格" Classes="section-title" />
                                        <ComboBox ItemsSource="{Binding PageSizeChoices}"
                                                  SelectedIndex="{Binding PageSizeIndex}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="页边距（mm）" Classes="section-title" />
                                        <NumericUpDown Minimum="0" Maximum="40" Increment="1"
                                                       Value="{Binding PageMarginMm}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="格子类型" Classes="section-title" />
                                <ComboBox SelectedIndex="{Binding GridKindIndex}">
                                    <ComboBoxItem Content="米字格" />
                                    <ComboBoxItem Content="田字格" />
                                    <ComboBoxItem Content="回宫格" />
                                    <ComboBoxItem Content="方格" />
                                    <ComboBoxItem Content="英文四线三格" />
                                    <ComboBoxItem Content="九宫格" />
                                    <ComboBoxItem Content="拼音四线格" />
                                </ComboBox>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <TextBlock Text="每行字数" Classes="section-title" />
                                        <ComboBox ItemsSource="{Binding CharactersPerLineChoices}"
                                                  SelectedIndex="{Binding CharactersPerLineIndex}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="隔空行" Classes="section-title" />
                                        <ComboBox ItemsSource="{Binding BlankLineChoices}"
                                                  SelectedItem="{Binding BlankLineCount}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="格子大小" Classes="section-title" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Slider Minimum="8" Maximum="60"
                                            Value="{Binding GridSizeMm}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding GridSizeMm, StringFormat={}{0:0} mm}"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <CheckBox Content="按词分组（词内字符连续，不拆行）"
                                          IsChecked="{Binding GroupByWord}" />
                                <CheckBox Content="竖排版式（从右到左，传统书法帖式）"
                                          IsChecked="{Binding IsVertical}" />
                            </StackPanel>
                        </Border>

                        <Border Classes="settings-section">
                            <StackPanel Spacing="8">
                                <TextBlock Text="练习方式" Classes="settings-section-title" />
                                <TextBlock Text="练习模式" Classes="section-title" />
                                <ComboBox SelectedIndex="{Binding PracticeModeIndex}">
                                    <ComboBoxItem Content="描红：范字 + 描红 + 空格" />
                                    <ComboBoxItem Content="临摹：范字 + 空格" />
                                </ComboBox>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <TextBlock Text="每字格数" Classes="section-title" />
                                        <ComboBox ItemsSource="{Binding RepeatsChoices}"
                                                  SelectedIndex="{Binding RepeatsIndex}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="描红深浅" Classes="section-title" />
                                        <ComboBox ItemsSource="{Binding TraceIntensityChoices}"
                                                  SelectedIndex="{Binding TraceIntensityIndex}"
                                                  IsEnabled="{Binding IsTraceMode}" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox Content="空心双钩字（范字描轮廓，供填墨）"
                                          IsChecked="{Binding HollowGlyph}" />
                            </StackPanel>
                        </Border>

                        <Border Classes="settings-section">
                            <StackPanel Spacing="8">
                                <TextBlock Text="字迹与纸张" Classes="settings-section-title" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <TextBlock Text="格子颜色" Classes="section-title" />
                                        <ComboBox ItemsSource="{Binding ColorChoices}"
                                                  SelectedIndex="{Binding GridColorIndex}" />
                                        <TextBox Text="{Binding GridColorHex}"
                                                 PlaceholderText="#B04A3F" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="文字颜色" Classes="section-title" />
                                        <ComboBox ItemsSource="{Binding ColorChoices}"
                                                  SelectedIndex="{Binding TextColorIndex}" />
                                        <TextBox Text="{Binding TextColorHex}"
                                                 PlaceholderText="#1A1A1A" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="字帖字体" Classes="section-title" />
                                <ComboBox ItemsSource="{Binding SheetFonts}"
                                          SelectedItem="{Binding SelectedSheetFont}"
                                          MaxDropDownHeight="360">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="services:FontOption">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontFamily="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="纸张底纹" Classes="section-title" />
                                <ComboBox SelectedIndex="{Binding BackgroundIndex}">
                                    <ComboBoxItem Content="白底（无底纹）" />
                                    <ComboBoxItem Content="红格纸（淡红横线）" />
                                    <ComboBoxItem Content="信纸（淡蓝横线）" />
                                    <ComboBoxItem Content="宣纸（暖白米色横线）" />
                                </ComboBox>
                                <CheckBox Content="页面装饰边框" IsChecked="{Binding FrameBorder}" />
                            </StackPanel>
                        </Border>

                        <Border Classes="settings-section">
                            <StackPanel Spacing="8">
                                <TextBlock Text="拼音与预览" Classes="settings-section-title" />
                                <CheckBox Content="标注拼音" IsChecked="{Binding ShowPinyin}" />
                                <CheckBox Content="只看拼音（隐藏范字，看拼音写词语）"
                                          IsChecked="{Binding PinyinOnly}"
                                          IsEnabled="{Binding ShowPinyin}" />
                                <TextBlock Text="显示缩放" Classes="section-title" />
                                <Slider Minimum="0.5" Maximum="2"
                                        TickFrequency="0.25" TickPlacement="BottomRight"
                                        Value="{Binding Zoom}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="*,Auto" Margin="12,12,12,6">
                <Border Grid.Row="0" Classes="preview-surface">
                    <zitie:ZitiePreview Spec="{Binding Spec}"
                                       Pages="{Binding Pages}"
                                       PageIndex="{Binding PageIndex}"
                                       Zoom="{Binding Zoom}" />
                </Border>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,8">
                    <Button Content="上一页" Command="{Binding PreviousPageCommand}" />
                    <TextBlock Grid.Column="1" Text="{Binding PageIndicator}"
                               Classes="page-indicator"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="下一页" Command="{Binding NextPageCommand}" />
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
