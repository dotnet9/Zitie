<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="https://codewf.com" xmlns:q="using:Zitie.Desktop.I18n"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:vm="using:Zitie.Desktop.ViewModels"
             xmlns:models="using:Zitie.Desktop.Models"
             xmlns:services="using:Zitie.Desktop.Services"
             xmlns:zitie="using:Zitie.Avalonia.Controls"
             xmlns:controls="using:Zitie.Desktop.Controls"
             x:Class="Zitie.Desktop.Views.SheetEditorView"
             x:DataType="vm:SheetEditorViewModel"
             Background="{DynamicResource ZitiePaperBrush}"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid Background="{DynamicResource ZitiePaperBrush}">
    <DockPanel Background="{DynamicResource ZitiePaperBrush}">
        <Border DockPanel.Dock="Top" Classes="editor-toolbar">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <ScrollViewer x:Name="CommandScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                <Button Grid.Column="0"
                        Classes="editor-icon-button"
                        Command="{Binding GoBackCommand}"
                        AutomationProperties.Name="{l:I18n {x:Static q:Language.BackToGallery}}"
                        ToolTip.Tip="{l:I18n {x:Static q:Language.BackToGallery}}">
                    <controls:ZitieIcon Data="M15,18 L9,12 L15,6"
                                        IconSize="{StaticResource ZitieToolbarBackIconSize}"
                                        StrokeThickness="2"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Border Grid.Column="1" Width="1" Height="20" Background="{DynamicResource ZitieBorderBrush}" Margin="6,0" />
                <Button Grid.Column="2"
                        Classes="template-switcher-button"
                        Command="{Binding OpenTemplatePickerCommand}"
                        AutomationProperties.Name="{l:I18n {x:Static q:Language.SwitchSheetTemplate}}"
                        ToolTip.Tip="{l:I18n {x:Static q:Language.SwitchTemplatePreservingContent}}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                        <TextBlock Text="{l:I18n {x:Static q:Language.Template}}"
                                   Classes="toolbar-label"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CurrentTemplateName}"
                                   Classes="template-switcher-name"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <controls:ZitieIcon Grid.Column="2"
                                            Data="M7,10 L12,15 L17,10"
                                            IconSize="15"
                                            StrokeThickness="2"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Grid>
                </Button>
                <Border Grid.Column="3" Width="1" Height="20" Background="{DynamicResource ZitieBorderBrush}" Margin="6,0" />
                <controls:ZitieToolButton Grid.Column="4"
                                          Content="{l:I18n {x:Static q:Language.Open}}"
                                          IconData="M3 8a2 2 0 0 1 2-2h4l2.2 2.5H19a2 2 0 0 1 2 2V17a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
                                          Command="{Binding OpenDocumentCommand}"
                                          AutomationProperties.Name="{l:I18n {x:Static q:Language.OpenSheetDocument}}"
                                          ToolTip.Tip="{l:I18n {x:Static q:Language.OpenSheetDocument}}" />
                <controls:ZitieToolButton Grid.Column="5"
                                          Content="{l:I18n {x:Static q:Language.Save}}"
                                          IconData="M5 3h11l3 3v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M8 3v5h7 M8 13h8v5H8z"
                                          Command="{Binding SaveDocumentCommand}"
                                          AutomationProperties.Name="{l:I18n {x:Static q:Language.SaveSheetDocument}}"
                                          ToolTip.Tip="{l:I18n {x:Static q:Language.SaveSheetDocument}}" />
                <controls:ZitieToolButton Grid.Column="6"
                                          Content="{l:I18n {x:Static q:Language.SaveAs}}"
                                          IconData="M5 3h11l3 3v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M14 17l4-4 1.5 1.5L15.5 18.5 13 19z"
                                          Command="{Binding SaveAsDocumentCommand}"
                                          AutomationProperties.Name="{l:I18n {x:Static q:Language.SaveSheetDocumentAs}}"
                                          ToolTip.Tip="{l:I18n {x:Static q:Language.SaveSheetDocumentAs}}" />
                <controls:ZitieToolButton Grid.Column="7"
                                          Content="{l:I18n {x:Static q:Language.SaveAsTemplate}}"
                                          IconData="M6 3h12v18l-6-4.2L6 21z"
                                          Command="{Binding SaveTemplateCommand}"
                                          AutomationProperties.Name="{l:I18n {x:Static q:Language.SaveReusableTemplate}}"
                                          ToolTip.Tip="{l:I18n {x:Static q:Language.SaveReusableTemplate}}" />
                </Grid>
                </ScrollViewer>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource ZitieAccentBrush}" IsVisible="{Binding IsDirty}" VerticalAlignment="Center" ToolTip.Tip="{l:I18n {x:Static q:Language.UnsavedChanges}}" />
                    <controls:ZitieToolButton Classes="outline"
                                              Content="{l:I18n {x:Static q:Language.BatchPng}}"
                                              IconData="M8 3h8v8H8z M3 13h8v8H3z M13 13h8v8h-8z"
                                              Command="{Binding ExportPngsCommand}"
                                              AutomationProperties.Name="{l:I18n {x:Static q:Language.BatchExportPages}}"
                                              ToolTip.Tip="{l:I18n {x:Static q:Language.ExportAllPagesPng}}" />
                    <controls:ZitieToolButton Classes="outline"
                                              Content="{l:I18n {x:Static q:Language.ExportPng}}"
                                              IconData="M3 5h18v14H3z M10.1 10a1.6 1.6 0 1 1-3.2 0 1.6 1.6 0 0 1 3.2 0z M21 16l-5-5-7 7"
                                              Command="{Binding ExportPngCommand}"
                                              AutomationProperties.Name="{l:I18n {x:Static q:Language.ExportCurrentPagePng}}"
                                              ToolTip.Tip="{l:I18n {x:Static q:Language.ExportCurrentPagePng}}" />
                    <controls:ZitieToolButton Classes="primary"
                                              Content="{l:I18n {x:Static q:Language.ExportPdf}}"
                                              IconData="M12 3v11 M7.5 10.5L12 15l4.5-4.5 M4 17.5V19a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-1.5"
                                              Command="{Binding ExportPdfCommand}"
                                              AutomationProperties.Name="{l:I18n {x:Static q:Language.ExportPdf}}"
                                              ToolTip.Tip="{l:I18n {x:Static q:Language.ExportPrintablePdf}}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Classes="editor-status-bar">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Border Classes="status-dot" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           Classes="status-text"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2"
                           Text="{Binding DocumentDisplayPath}"
                           Classes="status-path"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Grid ColumnDefinitions="316,*" MinHeight="0">
            <Border Grid.Column="0" Classes="editor-settings-panel">
                <TabControl Classes="editor-tabs"
                            ItemContainerTheme="{StaticResource ZitieEditorTabItemTheme}"
                            SelectedIndex="{Binding SettingsTabIndex}">
                    <TabItem AutomationProperties.Name="{l:I18n {x:Static q:Language.ContentSettings}}">
                        <TabItem.Header>
                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                <controls:ZitieIcon Data="M4,7 V5 A1,1 0 0 1 5,4 H19 A1,1 0 0 1 20,5 V7 M12,4 V20 M9,20 H15"
                                                    IconSize="18"
                                                    StrokeThickness="1.6"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                <TextBlock Text="{l:I18n {x:Static q:Language.Content}}" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Classes="editor-tab-body">
                                <Border Classes="editor-field">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{l:I18n {x:Static q:Language.PracticeText}}" Classes="editor-label" />
                                            <Border Grid.Column="1" Classes="field-badge" VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding InputTextSummary}" />
                                            </Border>
                                        </Grid>
                                        <TextBox Text="{Binding InputText}"
                                                 Classes="editor-input"
                                                 AutomationProperties.Name="{l:I18n {x:Static q:Language.PracticeText}}"
                                                 IsEnabled="{Binding IsContentEditingEnabled}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="108"
                                                 VerticalContentAlignment="Top"
                                                 PlaceholderText="{l:I18n {x:Static q:Language.PracticeTextPlaceholder}}" />
                                        <TextBlock Text="{l:I18n {x:Static q:Language.PracticeTextHint}}"
                                                   Classes="muted-text"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="editor-field">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                            <TextBlock Text="{l:I18n {x:Static q:Language.ContentLibrary}}" Classes="editor-label" Margin="0" />
                                            <Border Grid.Column="1" Classes="field-badge" VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding ContentSelection.SourceSummary}" />
                                            </Border>
                                        </Grid>
                                        <Button Classes="content-picker-button"
                                                Command="{Binding OpenContentPickerCommand}"
                                                IsEnabled="{Binding IsContentEditingEnabled}"
                                                AutomationProperties.Name="{l:I18n {x:Static q:Language.OpenContentLibrary}}">
                                            <Grid>
                                                <Rectangle Stroke="{DynamicResource ZitieAccentDisabledBrush}"
                                                           StrokeThickness="1"
                                                           StrokeDashArray="4,3"
                                                           RadiusX="10"
                                                           RadiusY="10"
                                                           IsHitTestVisible="False" />
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="8"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <controls:ZitieIcon Data="M4,19 V5 A2,2 0 0 1 6,3 H19 V21 H6 A2,2 0 0 1 4,19 Z M8,7 H15 M8,11 H15 M19,17 H6"
                                                                        IconSize="16"
                                                                        StrokeThickness="1.8"
                                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                    <TextBlock Text="{l:I18n {x:Static q:Language.OpenContentLibrary}}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <TextBlock Text="{l:I18n {x:Static q:Language.ContentLibraryHint}}"
                                                   Classes="muted-text"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Classes="editor-field">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{l:I18n {x:Static q:Language.Title}}" Classes="editor-label" />
                                        <TextBox Text="{Binding Title}" Classes="editor-input" AutomationProperties.Name="{l:I18n {x:Static q:Language.Title}}" PlaceholderText="{l:I18n {x:Static q:Language.NoTitlePlaceholder}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{l:I18n {x:Static q:Language.HeaderStyle}}" Classes="editor-label" />
                                        <ComboBox ItemsSource="{Binding HeaderPresetChoices}"
                                                  SelectedIndex="{Binding HeaderPresetIndex}"
                                                  AutomationProperties.Name="{l:I18n {x:Static q:Language.HeaderStyle}}"
                                                  IsEnabled="{Binding IsStandardPracticeLayout}"
                                                  Classes="editor-input" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Classes="editor-field">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{l:I18n {x:Static q:Language.Dynasty}}" Classes="editor-label" />
                                        <TextBox Text="{Binding Dynasty}" Classes="editor-input" AutomationProperties.Name="{l:I18n {x:Static q:Language.Dynasty}}" IsEnabled="{Binding IsPoemHeaderFieldsEnabled}" PlaceholderText="{l:I18n {x:Static q:Language.DynastyPlaceholder}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{l:I18n {x:Static q:Language.Author}}" Classes="editor-label" />
                                        <TextBox Text="{Binding Author}" Classes="editor-input" AutomationProperties.Name="{l:I18n {x:Static q:Language.Author}}" IsEnabled="{Binding IsPoemHeaderFieldsEnabled}" PlaceholderText="{l:I18n {x:Static q:Language.AuthorPlaceholder}}" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox Content="{l:I18n {x:Static q:Language.ShowPoemAuthor}}"
                                          Classes="editor-check"
                                          IsEnabled="{Binding IsStandardPracticeLayout}"
                                          IsChecked="{Binding ShowPoemHeader}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem AutomationProperties.Name="{l:I18n {x:Static q:Language.LayoutSettings}}">
                        <TabItem.Header>
                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                <controls:ZitieIcon Data="M3,3 H21 V21 H3 Z M3,9 H21 M9,3 V21"
                                                    IconSize="18"
                                                    StrokeThickness="1.6"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                <TextBlock Text="{l:I18n {x:Static q:Language.Layout}}" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Classes="editor-tab-body">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Classes="editor-field">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{l:I18n {x:Static q:Language.PaperSize}}" Classes="editor-label" />
                                        <ComboBox ItemsSource="{Binding PageSizeChoices}" SelectedIndex="{Binding PageSizeIndex}" Classes="editor-input" AutomationProperties.Name="{l:I18n {x:Static q:Language.PaperSize}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{l:I18n {x:Static q:Language.PageMargin}}" Classes="editor-label" />
                                        <NumericUpDown Classes="editor-input"
                                                       AutomationProperties.Name="{l:I18n {x:Static q:Language.PageMarginName}}"
                                                       Minimum="0" Maximum="40" Increment="1"
                                                       Value="{Binding PageMarginMm}" />
                                    </StackPanel>
                                </Grid>
                                <Border Classes="editor-field" IsEnabled="{Binding IsStandardPracticeLayout}">
                                    <StackPanel>
                                        <TextBlock Text="{l:I18n {x:Static q:Language.GridType}}" Classes="editor-label" />
                                        <ComboBox ItemsSource="{Binding GridKindChoices}" SelectedIndex="{Binding GridKindIndex}" Classes="editor-input" AutomationProperties.Name="{l:I18n {x:Static q:Language.GridType}}" />
                                    </StackPanel>
                                </Border>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Classes="editor-field" IsEnabled="{Binding IsStandardPracticeLayout}">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{l:I18n {x:Static q:Language.CellsPerRow}}" Classes="editor-label" />
                                        <ComboBox ItemsSource="{Binding CellsPerLineChoices}" SelectedIndex="{Binding CellsPerLineIndex}" Classes="editor-input" AutomationProperties.Name="{l:I18n {x:Static q:Language.CellsPerRow}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding BlankCellLineLabel}" Classes="editor-label" />
                                        <ComboBox ItemsSource="{Binding BlankCellLineChoices}" SelectedItem="{Binding BlankCellLineCount}" Classes="editor-input" AutomationProperties.Name="{Binding BlankCellLineLabel}" />
                                    </StackPanel>
                                </Grid>
                                <Border Classes="editor-field" IsEnabled="{Binding IsStandardPracticeLayout}">
                                    <StackPanel>
                                        <TextBlock Text="{l:I18n {x:Static q:Language.CellSize}}" Classes="editor-label" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Slider Classes="editor-slider"
                                                    AutomationProperties.Name="{l:I18n {x:Static q:Language.CellSize}}"
                                                    Minimum="8"
                                                    Maximum="60"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    Value="{Binding GridSizeMm}" />
                                            <TextBlock Grid.Column="1" Text="{Binding GridSizeMm, StringFormat={}{0:0} mm}" Classes="muted-text" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <CheckBox Content="{l:I18n {x:Static q:Language.GroupWords}}" Classes="editor-check" IsEnabled="{Binding IsStandardPracticeLayout}" IsChecked="{Binding GroupByWord}" />
                                <CheckBox Content="{l:I18n {x:Static q:Language.VerticalLayout}}" Classes="editor-check" IsEnabled="{Binding IsStandardPracticeLayout}" IsChecked="{Binding IsVertical}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem AutomationProperties.Name="{l:I18n {x:Static q:Language.PracticeSettings}}">
                        <TabItem.Header>
                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                <controls:ZitieIcon Data="M12,2 V5 M12,19 V22 M2,12 H5 M19,12 H22 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M19.1,4.9 L17,7 M7,17 L4.9,19.1 M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8"
                                                    IconSize="18"
                                                    StrokeThickness="1.6"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                <TextBlock Text="{l:I18n {x:Static q:Language.Practice}}" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Classes="editor-tab-body" IsEnabled="{Binding IsStandardPracticeLayout}">
                                <Border Classes="editor-field">
                                    <StackPanel>
                                        <TextBlock Text="{l:I18n {x:Static q:Language.PracticeMode}}" Classes="editor-label" />
                                        <ComboBox ItemsSource="{Binding PracticeModeChoices}" SelectedIndex="{Binding PracticeModeIndex}" Classes="editor-input" AutomationProperties.Name="{l:I18n {x:Static q:Language.PracticeMode}}" />
                                    </StackPanel>
                                </Border>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Classes="editor-field">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{l:I18n {x:Static q:Language.CellsPerCharacter}}" Classes="editor-label" />
                                        <ComboBox ItemsSource="{Binding RepeatsChoices}" SelectedIndex="{Binding RepeatsIndex}" Classes="editor-input" AutomationProperties.Name="{l:I18n {x:Static q:Language.CellsPerCharacter}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{l:I18n {x:Static q:Language.TracingOpacity}}" Classes="editor-label" />
                                        <ComboBox ItemsSource="{Binding TraceIntensityChoices}" SelectedIndex="{Binding TraceIntensityIndex}" IsEnabled="{Binding IsTraceMode}" Classes="editor-input" AutomationProperties.Name="{l:I18n {x:Static q:Language.TracingOpacity}}" />
                                    </StackPanel>
                                </Grid>
                                <Border Classes="editor-field">
                                    <StackPanel>
                                        <TextBlock Text="{l:I18n {x:Static q:Language.GroupSpacing}}" Classes="editor-label" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Slider Classes="editor-slider"
                                                    AutomationProperties.Name="{l:I18n {x:Static q:Language.GroupSpacing}}"
                                                    Minimum="1"
                                                    Maximum="10"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    Value="{Binding GroupGapMm}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding GroupGapMm, StringFormat={}{0:0} mm}"
                                                       Classes="muted-text"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <CheckBox Content="{l:I18n {x:Static q:Language.HollowGlyph}}" Classes="editor-check" IsChecked="{Binding HollowGlyph}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem AutomationProperties.Name="{l:I18n {x:Static q:Language.WritingSettings}}">
                        <TabItem.Header>
                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                <controls:ZitieIcon Data="M12,19 L19,12 A4.95,4.95 0 0 0 12,5 L5,12 V19 Z M18,13 L11,6"
                                                    IconSize="18"
                                                    StrokeThickness="1.6"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                <TextBlock Text="{l:I18n {x:Static q:Language.Writing}}" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Classes="editor-tab-body">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Classes="editor-field">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{l:I18n {x:Static q:Language.GridColor}}" Classes="editor-label" />
                                        <ComboBox ItemsSource="{Binding ColorChoices}" SelectedIndex="{Binding GridColorIndex}" Classes="editor-input" AutomationProperties.Name="{l:I18n {x:Static q:Language.GridColorPreset}}" />
                                        <TextBox Text="{Binding GridColorHex}" Classes="editor-input" AutomationProperties.Name="{l:I18n {x:Static q:Language.GridColorValue}}" PlaceholderText="#B04A3F" Margin="{StaticResource ZitieEditorSubcontrolSpacing}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{l:I18n {x:Static q:Language.TextColor}}" Classes="editor-label" />
                                        <ComboBox ItemsSource="{Binding ColorChoices}" SelectedIndex="{Binding TextColorIndex}" Classes="editor-input" AutomationProperties.Name="{l:I18n {x:Static q:Language.TextColorPreset}}" />
                                        <TextBox Text="{Binding TextColorHex}" Classes="editor-input" AutomationProperties.Name="{l:I18n {x:Static q:Language.TextColorValue}}" PlaceholderText="#1A1A1A" Margin="{StaticResource ZitieEditorSubcontrolSpacing}" />
                                    </StackPanel>
                                </Grid>
                                <Border Classes="editor-field">
                                    <StackPanel>
                                        <TextBlock Text="{l:I18n {x:Static q:Language.SheetFont}}" Classes="editor-label" />
                                        <ComboBox ItemsSource="{Binding SheetFonts}" SelectedItem="{Binding SelectedSheetFont}" Classes="editor-input" AutomationProperties.Name="{l:I18n {x:Static q:Language.SheetFont}}" MaxDropDownHeight="360">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:FontOption">
                                                    <TextBlock Text="{Binding DisplayName}" FontFamily="{Binding PreviewFamilyName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="{Binding SelectedSheetFont.Description}"
                                                   Classes="muted-text"
                                                   Margin="{StaticResource ZitieEditorSubcontrolSpacing}" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="editor-field">
                                    <StackPanel>
                                        <TextBlock Text="{l:I18n {x:Static q:Language.PaperTexture}}" Classes="editor-label" />
                                        <ComboBox ItemsSource="{Binding BackgroundChoices}" SelectedIndex="{Binding BackgroundIndex}" Classes="editor-input" AutomationProperties.Name="{l:I18n {x:Static q:Language.PaperTexture}}" />
                                    </StackPanel>
                                </Border>
                                <CheckBox Content="{l:I18n {x:Static q:Language.DecorativeFrame}}" Classes="editor-check" IsChecked="{Binding FrameBorder}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem AutomationProperties.Name="{l:I18n {x:Static q:Language.PinyinSettings}}">
                        <TabItem.Header>
                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                <controls:ZitieIcon Data="M4,12 H7 L9,6 L13,18 L15,12 H20"
                                                    IconSize="18"
                                                    StrokeThickness="1.6"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                <TextBlock Text="{l:I18n {x:Static q:Language.Pinyin}}" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Classes="editor-tab-body" IsEnabled="{Binding IsStandardPracticeLayout}">
                                <CheckBox Content="{l:I18n {x:Static q:Language.ShowPinyin}}" Classes="editor-check" IsChecked="{Binding ShowPinyin}" />
                                <CheckBox Content="{l:I18n {x:Static q:Language.PinyinOnly}}"
                                          Classes="editor-check"
                                          IsChecked="{Binding PinyinOnly}"
                                          IsEnabled="{Binding ShowPinyin}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="*,Auto" MinWidth="0">
                <Border Grid.Row="0" Classes="preview-stage">
                    <Grid>
                        <TextBlock Text="{l:I18n {x:Static q:Language.WorkshopTitle}}"
                                   Foreground="{DynamicResource ZitieInkMutedBrush}"
                                   Opacity="0.55"
                                   FontSize="{DynamicResource ZitieUiFontSizeSmall}"
                                   LetterSpacing="10"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Margin="0,16,0,0" />
                        <zitie:ZitiePreview Spec="{Binding Spec}"
                                           Pages="{Binding Pages}"
                                           PageIndex="{Binding PageIndex}"
                                           Zoom="{Binding Zoom}"
                                           Background="Transparent"
                                           HorizontalContentAlignment="Center"
                                           VerticalContentAlignment="Center" />
                    </Grid>
                </Border>
                <Border Grid.Row="1" Classes="stage-bar">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <controls:ZitieStepper ValueText="{Binding PageIndicator}"
                                               AutomationProperties.Name="{l:I18n {x:Static q:Language.PageNavigation}}"
                                               ValueWidth="60"
                                               DecreaseIconData="M15 18l-6-6 6-6"
                                               IncreaseIconData="M9 6l6 6-6 6"
                                               DecreaseCommand="{Binding PreviousPageCommand}"
                                               IncreaseCommand="{Binding NextPageCommand}"
                                               DecreaseToolTip="{l:I18n {x:Static q:Language.PreviousPage}}"
                                               IncreaseToolTip="{l:I18n {x:Static q:Language.NextPage}}" />
                        <Grid Grid.Column="2"
                              ColumnDefinitions="Auto,Auto,Auto"
                              ColumnSpacing="8"
                              VerticalAlignment="Center">
                            <TextBlock Text="{l:I18n {x:Static q:Language.Zoom}}"
                                       Classes="gallery-count"
                                       VerticalAlignment="Center" />
                            <Slider Grid.Column="1"
                                    Width="{StaticResource ZitieStageZoomSliderWidth}"
                                    Classes="gallery-zoom"
                                    AutomationProperties.Name="{l:I18n {x:Static q:Language.CanvasZoom}}"
                                    ToolTip.Tip="{l:I18n {x:Static q:Language.ZoomCanvas}}"
                                    Minimum="0.3"
                                    Maximum="2"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding Zoom}" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Zoom, StringFormat={}{0:P0}}"
                                       Classes="gallery-count"
                                       MinWidth="{StaticResource ZitieStageZoomValueWidth}"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>

    <Grid IsVisible="{Binding IsTemplatePickerOpen}"
          ZIndex="20">
        <Border Background="{DynamicResource ZitieOverlayBrush}" />
        <Border Classes="content-drawer template-drawer"
                HorizontalAlignment="Right">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{l:I18n {x:Static q:Language.SwitchTemplate}}" Classes="content-drawer-title" />
                            <TextBlock Text="TEMPLATE PREVIEW"
                                       Classes="content-drawer-title-en"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,2" />
                        </StackPanel>
                        <TextBlock Text="{Binding TemplateFilterSummary}"
                                   Classes="content-drawer-summary"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="content-drawer-close"
                            Command="{Binding CloseTemplatePickerCommand}"
                            AutomationProperties.Name="{l:I18n {x:Static q:Language.CloseTemplatePicker}}"
                            ToolTip.Tip="{l:I18n {x:Static q:Language.Close}}">
                        <controls:ZitieIcon Data="M6,6 L18,18 M18,6 L6,18"
                                            IconSize="18"
                                            StrokeThickness="2"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding TemplateSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Classes="editor-input content-search"
                             AutomationProperties.Name="{l:I18n {x:Static q:Language.QuickTemplateSearch}}"
                             PlaceholderText="{l:I18n {x:Static q:Language.SearchTemplateDetails}}">
                        <TextBox.InnerLeftContent>
                            <controls:ZitieIcon Data="M11 4a7 7 0 1 0 7 7 7 7 0 0 0-7-7z M20 20l-3.5-3.5"
                                                IconSize="15"
                                                StrokeThickness="2"
                                                Foreground="{DynamicResource ZitieInkMutedBrush}"
                                                Margin="10,0,6,0" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <Button Grid.Column="1"
                            Content="{l:I18n {x:Static q:Language.Reset}}"
                            Classes="gallery-action"
                            Command="{Binding ResetTemplateSearchCommand}"
                            AutomationProperties.Name="{l:I18n {x:Static q:Language.ResetTemplateSearch}}" />
                </Grid>

                <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="0,14,0,0" MinHeight="0">
                    <Border Classes="content-results-header">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{l:I18n {x:Static q:Language.TemplateList}}" Classes="content-section-label" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TemplateFilterSummary}"
                                       Classes="content-section-label" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <TextBlock Text="{l:I18n {x:Static q:Language.NoTemplatesFound}}"
                                   Classes="module-empty"
                                   IsVisible="{Binding IsTemplateFilterEmpty}"
                                   Margin="2,12,0,0" />
                        <ListBox ItemsSource="{Binding FilteredTemplateChoices}"
                                 SelectedItem="{Binding PreviewTemplateModule}"
                                 Classes="template-results"
                                 AutomationProperties.Name="{l:I18n {x:Static q:Language.TemplateResults}}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="services:ModuleDefinition">
                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="5">
                                        <TextBlock Text="{Binding Name}"
                                                   Classes="template-result-title"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Description}"
                                                   Classes="template-result-description"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>

                <Border Grid.Row="3" Classes="content-drawer-footer">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Button Classes="content-apply-button"
                                Command="{Binding ApplySelectedTemplateCommand}"
                                AutomationProperties.Name="{l:I18n {x:Static q:Language.ApplyTemplate}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:ZitieIcon Data="M20,6 L9,17 L4,12"
                                                    IconSize="16"
                                                    StrokeThickness="2"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="{l:I18n {x:Static q:Language.ApplyTemplate}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="1"
                                   Text="{l:I18n {x:Static q:Language.KeepPracticeText}}"
                                   Classes="muted-text"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>

    <Grid IsVisible="{Binding IsContentPickerOpen}"
          ZIndex="20">
        <Border Background="{DynamicResource ZitieOverlayBrush}" />
        <Border Classes="content-drawer"
                HorizontalAlignment="Right">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{l:I18n {x:Static q:Language.ContentLibrary}}" Classes="content-drawer-title" />
                            <TextBlock Text="CONTENT LIBRARY"
                                       Classes="content-drawer-title-en"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,2" />
                        </StackPanel>
                        <TextBlock Text="{Binding ContentSelection.FilterSummary}"
                                   Classes="content-drawer-summary"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="content-drawer-close"
                            Command="{Binding CloseContentPickerCommand}"
                            AutomationProperties.Name="{l:I18n {x:Static q:Language.CloseContentLibrary}}"
                            ToolTip.Tip="{l:I18n {x:Static q:Language.Close}}">
                        <controls:ZitieIcon Data="M6,6 L18,18 M18,6 L6,18"
                                            IconSize="18"
                                            StrokeThickness="2"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding ContentSelection.SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Classes="editor-input content-search"
                             AutomationProperties.Name="{l:I18n {x:Static q:Language.QuickContentSearch}}"
                             PlaceholderText="{l:I18n {x:Static q:Language.SearchContentDetails}}">
                        <TextBox.InnerLeftContent>
                            <controls:ZitieIcon Data="M11 4a7 7 0 1 0 7 7 7 7 0 0 0-7-7z M20 20l-3.5-3.5"
                                                IconSize="15"
                                                StrokeThickness="2"
                                                Foreground="{DynamicResource ZitieInkMutedBrush}"
                                                Margin="10,0,6,0" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <Button Grid.Column="1"
                            Content="{l:I18n {x:Static q:Language.Reset}}"
                            Classes="gallery-action"
                            Command="{Binding ResetContentFiltersCommand}"
                            AutomationProperties.Name="{l:I18n {x:Static q:Language.ResetContentFilters}}" />
                </Grid>

                <Grid Grid.Row="2"
                      RowDefinitions="Auto,Auto,Auto"
                      ColumnDefinitions="*,*"
                      RowSpacing="8"
                      ColumnSpacing="8"
                      Margin="0,12,0,0">
                        <ComboBox Grid.Row="0" Grid.Column="0"
                                  ItemsSource="{Binding ContentSelection.Subjects}"
                                  SelectedItem="{Binding ContentSelection.SelectedSubject}"
                                  Classes="editor-input"
                                  AutomationProperties.Name="{l:I18n {x:Static q:Language.ContentSubject}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{l:I18n {x:Static q:Language.SubjectFilter}, {Binding .}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding ContentSelection.Editions}"
                                  SelectedItem="{Binding ContentSelection.SelectedEdition}"
                                  Classes="editor-input"
                                  AutomationProperties.Name="{l:I18n {x:Static q:Language.TextbookEdition}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{l:I18n {x:Static q:Language.EditionFilter}, {Binding .}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Row="1" Grid.Column="0"
                                  ItemsSource="{Binding ContentSelection.Grades}"
                                  SelectedItem="{Binding ContentSelection.SelectedGrade}"
                                  Classes="editor-input"
                                  AutomationProperties.Name="{l:I18n {x:Static q:Language.ContentGrade}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{l:I18n {x:Static q:Language.GradeFilter}, {Binding .}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding ContentSelection.Semesters}"
                                  SelectedItem="{Binding ContentSelection.SelectedSemester}"
                                  Classes="editor-input"
                                  AutomationProperties.Name="{l:I18n {x:Static q:Language.ContentSemester}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{l:I18n {x:Static q:Language.SemesterFilter}, {Binding .}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Row="2" Grid.ColumnSpan="2"
                                  ItemsSource="{Binding ContentSelection.Units}"
                                  SelectedItem="{Binding ContentSelection.SelectedUnit}"
                                  Classes="editor-input"
                                  AutomationProperties.Name="{l:I18n {x:Static q:Language.ContentUnit}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{l:I18n {x:Static q:Language.UnitFilter}, {Binding .}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                </Grid>

                    <StackPanel Grid.Row="3"
                                IsVisible="{Binding ContentSelection.HasRecentItems}"
                                Spacing="8"
                                Margin="0,14,0,0">
                        <TextBlock Text="{l:I18n {x:Static q:Language.RecentlyUsed}}" Classes="content-section-label" />
                        <ListBox ItemsSource="{Binding ContentSelection.RecentItems}"
                                 SelectedItem="{Binding ContentSelection.SelectedResult}"
                                 Classes="recent-content-list"
                                 AutomationProperties.Name="{l:I18n {x:Static q:Language.RecentContent}}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:TextContentSearchResult">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Title}" Classes="recent-content-title" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DisplayPath}" Classes="recent-content-path" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                <Grid Grid.Row="4" RowDefinitions="Auto,*" Margin="0,14,0,0" MinHeight="0">
                    <Border Classes="content-results-header">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{l:I18n {x:Static q:Language.SearchResults}}" Classes="content-section-label" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ContentSelection.ResultCountSummary}"
                                       Classes="content-section-label" />
                        </Grid>
                    </Border>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding ContentSelection.FilteredItems}"
                             SelectedItem="{Binding ContentSelection.SelectedResult}"
                             Classes="content-results"
                             AutomationProperties.Name="{l:I18n {x:Static q:Language.ContentResults}}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:TextContentSearchResult">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                    <ItemsControl ItemsSource="{Binding TitleSegments}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:TextHighlightSegment">
                                                <TextBlock Text="{Binding Text}"
                                                           Classes="content-segment title"
                                                           Classes.highlight="{Binding IsHighlight}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding PathSegments}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:TextHighlightSegment">
                                                <TextBlock Text="{Binding Text}"
                                                           Classes="content-segment path"
                                                           Classes.highlight="{Binding IsHighlight}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding ExcerptSegments}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:TextHighlightSegment">
                                                <TextBlock Text="{Binding Text}"
                                                           Classes="content-segment excerpt"
                                                           Classes.highlight="{Binding IsHighlight}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Border Grid.Row="5" Classes="content-drawer-footer">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Button Classes="content-apply-button"
                                Command="{Binding ApplySelectedContentCommand}"
                                AutomationProperties.Name="{l:I18n {x:Static q:Language.ApplyContent}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:ZitieIcon Data="M20,6 L9,17 L4,12"
                                                    IconSize="16"
                                                    StrokeThickness="2"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="{l:I18n {x:Static q:Language.ApplyContent}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="1"
                                   Text="{l:I18n {x:Static q:Language.ApplyToPracticeText}}"
                                   Classes="muted-text"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</UserControl>
