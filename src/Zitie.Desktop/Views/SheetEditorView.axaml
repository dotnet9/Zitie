<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:vm="using:Zitie.Desktop.ViewModels"
             xmlns:services="using:Zitie.Desktop.Services"
             xmlns:zitie="using:Zitie.Avalonia.Controls"
             xmlns:controls="using:Zitie.Desktop.Controls"
             x:Class="Zitie.Desktop.Views.SheetEditorView"
             x:DataType="vm:SheetEditorViewModel"
             Background="{DynamicResource ZitiePaperBrush}"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <DockPanel Background="{DynamicResource ZitiePaperBrush}">
        <Border DockPanel.Dock="Top" Classes="editor-toolbar">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="6">
                <Button Grid.Column="0"
                        Classes="editor-icon-button"
                        Command="{Binding GoBackCommand}"
                        AutomationProperties.Name="返回模板库"
                        ToolTip.Tip="返回模板库">
                    <controls:ZitieIcon Data="M15,18 L9,12 L15,6"
                                        IconSize="{StaticResource ZitieToolbarBackIconSize}"
                                        StrokeThickness="2"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Border Grid.Column="1" Width="1" Height="20" Background="{DynamicResource ZitieBorderBrush}" Margin="6,0" />
                <controls:ZitieToolButton Grid.Column="2"
                                          Content="打开"
                                          IconData="M3 8a2 2 0 0 1 2-2h4l2.2 2.5H19a2 2 0 0 1 2 2V17a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
                                          Command="{Binding OpenDocumentCommand}"
                                          AutomationProperties.Name="打开字帖文档"
                                          ToolTip.Tip="打开字帖文档" />
                <controls:ZitieToolButton Grid.Column="3"
                                          Content="保存"
                                          IconData="M5 3h11l3 3v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M8 3v5h7 M8 13h8v5H8z"
                                          Command="{Binding SaveDocumentCommand}"
                                          AutomationProperties.Name="保存字帖文档"
                                          ToolTip.Tip="保存字帖文档" />
                <controls:ZitieToolButton Grid.Column="4"
                                          Content="另存"
                                          IconData="M5 3h11l3 3v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M14 17l4-4 1.5 1.5L15.5 18.5 13 19z"
                                          Command="{Binding SaveAsDocumentCommand}"
                                          AutomationProperties.Name="另存字帖文档"
                                          ToolTip.Tip="另存字帖文档" />
                <controls:ZitieToolButton Grid.Column="5"
                                          Content="存为模板"
                                          IconData="M6 3h12v18l-6-4.2L6 21z"
                                          Command="{Binding SaveTemplateCommand}"
                                          AutomationProperties.Name="保存为可复用模板"
                                          ToolTip.Tip="保存为可复用模板" />
                <StackPanel Grid.Column="7"
                            Orientation="Horizontal"
                            Spacing="6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="未保存更改 ·" Classes="dirty-indicator" IsVisible="{Binding IsDirty}" VerticalAlignment="Center" />
                    <controls:ZitieToolButton Classes="outline"
                                              Content="批量 PNG"
                                              IconData="M8 3h8v8H8z M3 13h8v8H3z M13 13h8v8h-8z"
                                              Command="{Binding ExportPngsCommand}"
                                              AutomationProperties.Name="按页批量导出 PNG"
                                              ToolTip.Tip="按页导出多张 PNG" />
                    <controls:ZitieToolButton Classes="outline"
                                              Content="导出 PNG"
                                              IconData="M3 5h18v14H3z M10.1 10a1.6 1.6 0 1 1-3.2 0 1.6 1.6 0 0 1 3.2 0z M21 16l-5-5-7 7"
                                              Command="{Binding ExportPngCommand}"
                                              AutomationProperties.Name="导出当前页 PNG"
                                              ToolTip.Tip="导出当前页 PNG" />
                    <controls:ZitieToolButton Classes="primary"
                                              Content="导出 PDF"
                                              IconData="M12 3v11 M7.5 10.5L12 15l4.5-4.5 M4 17.5V19a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-1.5"
                                              Command="{Binding ExportPdfCommand}"
                                              AutomationProperties.Name="导出 PDF"
                                              ToolTip.Tip="导出 PDF（适合打印）" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Classes="editor-status-bar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Classes="status-dot" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           Classes="status-text"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2"
                           Text="{Binding DocumentPath, StringFormat={}文档：{0}}"
                           Classes="status-path"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Grid ColumnDefinitions="316,*" MinHeight="0">
            <Border Grid.Column="0" Classes="editor-settings-panel">
                <TabControl Classes="editor-tabs"
                            ItemContainerTheme="{StaticResource ZitieEditorTabItemTheme}"
                            SelectedIndex="{Binding SettingsTabIndex}">
                    <TabItem AutomationProperties.Name="内容设置">
                        <TabItem.Header>
                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                <controls:ZitieIcon Data="M4,7 V5 A1,1 0 0 1 5,4 H19 A1,1 0 0 1 20,5 V7 M12,4 V20 M9,20 H15"
                                                    IconSize="18"
                                                    StrokeThickness="1.6"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                <TextBlock Text="内容" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Classes="editor-tab-body">
                                <Border Classes="editor-field">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="练习文本" Classes="editor-label" />
                                            <Border Grid.Column="1" Classes="field-badge" VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding InputTextSummary}" />
                                            </Border>
                                        </Grid>
                                        <TextBox Text="{Binding InputText}"
                                                 Classes="editor-input"
                                                 AutomationProperties.Name="练习文本"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="108"
                                                 VerticalContentAlignment="Top"
                                                 PlaceholderText="输入要练习的字，逐字生成练习组" />
                                        <TextBlock Text="自动按标点分句，逐字生成练习组"
                                                   Classes="muted-text"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="editor-field">
                                    <StackPanel>
                                        <TextBlock Text="从文本库选择" Classes="editor-label" />
                                        <ComboBox ItemsSource="{Binding TextEntries}"
                                                  SelectedIndex="{Binding TextEntryIndex}"
                                                  Classes="editor-input"
                                                  AutomationProperties.Name="从文本库选择"
                                                  MaxDropDownHeight="360"
                                                  PlaceholderText="选择诗词 / 蒙学 / 名言 / 英文">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="services:TextEntry">
                                                    <StackPanel Spacing="1">
                                                        <TextBlock Text="{Binding Title}" />
                                                        <TextBlock Text="{Binding Category, StringFormat={}分类：{0}}" Classes="muted-text" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Classes="editor-field">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="标题" Classes="editor-label" />
                                        <TextBox Text="{Binding Title}" Classes="editor-input" AutomationProperties.Name="标题" PlaceholderText="留空则不显示" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="页头样式" Classes="editor-label" />
                                        <ComboBox ItemsSource="{Binding HeaderPresetChoices}"
                                                  SelectedIndex="{Binding HeaderPresetIndex}"
                                                  AutomationProperties.Name="页头样式"
                                                  Classes="editor-input" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Classes="editor-field">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="朝代" Classes="editor-label" />
                                        <TextBox Text="{Binding Dynasty}" Classes="editor-input" AutomationProperties.Name="朝代" IsEnabled="{Binding IsPoemHeader}" PlaceholderText="唐" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="作者" Classes="editor-label" />
                                        <TextBox Text="{Binding Author}" Classes="editor-input" AutomationProperties.Name="作者" IsEnabled="{Binding IsPoemHeader}" PlaceholderText="李白" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox Content="题头显示作者（朝代 · 作者）"
                                          Classes="editor-check"
                                          IsChecked="{Binding ShowPoemHeader}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem AutomationProperties.Name="版式设置">
                        <TabItem.Header>
                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                <controls:ZitieIcon Data="M3,3 H21 V21 H3 Z M3,9 H21 M9,3 V21"
                                                    IconSize="18"
                                                    StrokeThickness="1.6"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                <TextBlock Text="版式" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Classes="editor-tab-body">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Classes="editor-field">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="纸张规格" Classes="editor-label" />
                                        <ComboBox ItemsSource="{Binding PageSizeChoices}" SelectedIndex="{Binding PageSizeIndex}" Classes="editor-input" AutomationProperties.Name="纸张规格" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="页边距（mm）" Classes="editor-label" />
                                        <NumericUpDown Classes="editor-input"
                                                       AutomationProperties.Name="页边距"
                                                       Minimum="0" Maximum="40" Increment="1"
                                                       Value="{Binding PageMarginMm}" />
                                    </StackPanel>
                                </Grid>
                                <Border Classes="editor-field">
                                    <StackPanel>
                                        <TextBlock Text="格子类型" Classes="editor-label" />
                                        <ComboBox SelectedIndex="{Binding GridKindIndex}" Classes="editor-input" AutomationProperties.Name="格子类型">
                                            <ComboBoxItem Content="米字格" />
                                            <ComboBoxItem Content="田字格" />
                                            <ComboBoxItem Content="回宫格" />
                                            <ComboBoxItem Content="方格" />
                                            <ComboBoxItem Content="英文四线三格" />
                                            <ComboBoxItem Content="九宫格" />
                                            <ComboBoxItem Content="拼音四线格" />
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Classes="editor-field">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="每行字数" Classes="editor-label" />
                                        <ComboBox ItemsSource="{Binding CharactersPerLineChoices}" SelectedIndex="{Binding CharactersPerLineIndex}" Classes="editor-input" AutomationProperties.Name="每行字数" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="隔空行" Classes="editor-label" />
                                        <ComboBox ItemsSource="{Binding BlankLineChoices}" SelectedItem="{Binding BlankLineCount}" Classes="editor-input" AutomationProperties.Name="隔空行" />
                                    </StackPanel>
                                </Grid>
                                <Border Classes="editor-field">
                                    <StackPanel>
                                        <TextBlock Text="格子大小" Classes="editor-label" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Slider Classes="editor-slider"
                                                    AutomationProperties.Name="格子大小"
                                                    Minimum="8"
                                                    Maximum="60"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    Value="{Binding GridSizeMm}" />
                                            <TextBlock Grid.Column="1" Text="{Binding GridSizeMm, StringFormat={}{0:0} mm}" Classes="muted-text" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <CheckBox Content="按词分组（词内字符连续，不拆行）" Classes="editor-check" IsChecked="{Binding GroupByWord}" />
                                <CheckBox Content="竖排版式（从右到左，传统书法帖式）" Classes="editor-check" IsChecked="{Binding IsVertical}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem AutomationProperties.Name="练习设置">
                        <TabItem.Header>
                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                <controls:ZitieIcon Data="M12,2 V5 M12,19 V22 M2,12 H5 M19,12 H22 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M19.1,4.9 L17,7 M7,17 L4.9,19.1 M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8"
                                                    IconSize="18"
                                                    StrokeThickness="1.6"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                <TextBlock Text="练习" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Classes="editor-tab-body">
                                <Border Classes="editor-field">
                                    <StackPanel>
                                        <TextBlock Text="练习模式" Classes="editor-label" />
                                        <ComboBox SelectedIndex="{Binding PracticeModeIndex}" Classes="editor-input" AutomationProperties.Name="练习模式">
                                            <ComboBoxItem Content="描红：范字 + 描红 + 空格" />
                                            <ComboBoxItem Content="临摹：范字 + 空格" />
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Classes="editor-field">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="每字格数" Classes="editor-label" />
                                        <ComboBox ItemsSource="{Binding RepeatsChoices}" SelectedIndex="{Binding RepeatsIndex}" Classes="editor-input" AutomationProperties.Name="每字格数" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="描红深浅" Classes="editor-label" />
                                        <ComboBox ItemsSource="{Binding TraceIntensityChoices}" SelectedIndex="{Binding TraceIntensityIndex}" IsEnabled="{Binding IsTraceMode}" Classes="editor-input" AutomationProperties.Name="描红深浅" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox Content="空心双钩字（范字描轮廓，供填墨）" Classes="editor-check" IsChecked="{Binding HollowGlyph}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem AutomationProperties.Name="字迹设置">
                        <TabItem.Header>
                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                <controls:ZitieIcon Data="M12,19 L19,12 A4.95,4.95 0 0 0 12,5 L5,12 V19 Z M18,13 L11,6"
                                                    IconSize="18"
                                                    StrokeThickness="1.6"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                <TextBlock Text="字迹" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Classes="editor-tab-body">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Classes="editor-field">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="格子颜色" Classes="editor-label" />
                                        <ComboBox ItemsSource="{Binding ColorChoices}" SelectedIndex="{Binding GridColorIndex}" Classes="editor-input" AutomationProperties.Name="格子颜色预设" />
                                        <TextBox Text="{Binding GridColorHex}" Classes="editor-input" AutomationProperties.Name="格子颜色值" PlaceholderText="#B04A3F" Margin="{StaticResource ZitieEditorSubcontrolSpacing}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="文字颜色" Classes="editor-label" />
                                        <ComboBox ItemsSource="{Binding ColorChoices}" SelectedIndex="{Binding TextColorIndex}" Classes="editor-input" AutomationProperties.Name="文字颜色预设" />
                                        <TextBox Text="{Binding TextColorHex}" Classes="editor-input" AutomationProperties.Name="文字颜色值" PlaceholderText="#1A1A1A" Margin="{StaticResource ZitieEditorSubcontrolSpacing}" />
                                    </StackPanel>
                                </Grid>
                                <Border Classes="editor-field">
                                    <StackPanel>
                                        <TextBlock Text="字帖字体" Classes="editor-label" />
                                        <ComboBox ItemsSource="{Binding SheetFonts}" SelectedItem="{Binding SelectedSheetFont}" Classes="editor-input" AutomationProperties.Name="字帖字体" MaxDropDownHeight="360">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="services:FontOption">
                                                    <TextBlock Text="{Binding DisplayName}" FontFamily="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                                <Border Classes="editor-field">
                                    <StackPanel>
                                        <TextBlock Text="纸张底纹" Classes="editor-label" />
                                        <ComboBox SelectedIndex="{Binding BackgroundIndex}" Classes="editor-input" AutomationProperties.Name="纸张底纹">
                                            <ComboBoxItem Content="白底（无底纹）" />
                                            <ComboBoxItem Content="红格纸（淡红横线）" />
                                            <ComboBoxItem Content="信纸（淡蓝横线）" />
                                            <ComboBoxItem Content="宣纸（暖白米色横线）" />
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                                <CheckBox Content="页面装饰边框" Classes="editor-check" IsChecked="{Binding FrameBorder}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem AutomationProperties.Name="拼音设置">
                        <TabItem.Header>
                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                <controls:ZitieIcon Data="M4,12 H7 L9,6 L13,18 L15,12 H20"
                                                    IconSize="18"
                                                    StrokeThickness="1.6"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                <TextBlock Text="拼音" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Classes="editor-tab-body">
                                <CheckBox Content="标注拼音" Classes="editor-check" IsChecked="{Binding ShowPinyin}" />
                                <CheckBox Content="只看拼音（隐藏范字，看拼音写词语）"
                                          Classes="editor-check"
                                          IsChecked="{Binding PinyinOnly}"
                                          IsEnabled="{Binding ShowPinyin}" />
                                <Border Classes="editor-field">
                                    <StackPanel>
                                        <TextBlock Text="显示缩放" Classes="editor-label" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Slider Classes="editor-slider"
                                                    AutomationProperties.Name="拼音显示缩放"
                                                    Minimum="0.3"
                                                    Maximum="2"
                                                    TickFrequency="0.1"
                                                    IsSnapToTickEnabled="True"
                                                    Value="{Binding Zoom}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Zoom, StringFormat={}{0:P0}}" Classes="muted-text" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="*,Auto" MinWidth="0">
                <Border Grid.Row="0" Classes="preview-stage">
                    <Grid>
                        <TextBlock Text="字 帖 工 坊"
                                   Foreground="{DynamicResource ZitieInkMutedBrush}"
                                   Opacity="0.55"
                                   FontSize="12"
                                   LetterSpacing="10"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Margin="0,16,0,0" />
                        <zitie:ZitiePreview Spec="{Binding Spec}"
                                           Pages="{Binding Pages}"
                                           PageIndex="{Binding PageIndex}"
                                           Zoom="{Binding Zoom}"
                                           Background="Transparent"
                                           HorizontalContentAlignment="Center"
                                           VerticalContentAlignment="Center" />
                    </Grid>
                </Border>
                <Border Grid.Row="1" Classes="stage-bar">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <controls:ZitieStepper ValueText="{Binding PageIndicator}"
                                               AutomationProperties.Name="分页控制"
                                               ValueWidth="60"
                                               DecreaseIconData="M15 18l-6-6 6-6"
                                               IncreaseIconData="M9 6l6 6-6 6"
                                               DecreaseCommand="{Binding PreviousPageCommand}"
                                               IncreaseCommand="{Binding NextPageCommand}"
                                               DecreaseToolTip="上一页"
                                               IncreaseToolTip="下一页" />
                        <Grid Grid.Column="2"
                              ColumnDefinitions="Auto,Auto"
                              ColumnSpacing="8"
                              VerticalAlignment="Center">
                            <Slider Width="{StaticResource ZitieStageZoomSliderWidth}"
                                    Classes="editor-slider"
                                    AutomationProperties.Name="画布缩放"
                                    Minimum="0.3"
                                    Maximum="2"
                                    TickFrequency="0.1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding Zoom}" />
                            <TextBlock Grid.Column="1"
                                       MinWidth="{StaticResource ZitieStageZoomValueWidth}"
                                       Text="{Binding Zoom, StringFormat={}{0:P0}}"
                                       TextAlignment="Center"
                                       Classes="muted-text"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
