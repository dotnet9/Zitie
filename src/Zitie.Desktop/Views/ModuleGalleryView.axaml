<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Zitie.Desktop.ViewModels"
             xmlns:controls="using:Zitie.Desktop.Controls"
             x:Class="Zitie.Desktop.Views.ModuleGalleryView"
             x:DataType="vm:ModuleGalleryViewModel"
             Background="{DynamicResource ZitiePaperBrush}"
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:prism="http://prismlibrary.com/">
    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource ZitiePaperBrush}">
        <StackPanel Grid.Row="0" Margin="26,22,26,0" Spacing="0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Border Classes="page-title-accent" />
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
                            <TextBlock Text="样式分类" Classes="page-title" />
                            <TextBlock Text="TEMPLATE GALLERY" Classes="page-title-en" />
                        </StackPanel>
                        <TextBlock Text="选择模板开始生成字帖 · 内置模板与自定义模板均为 YAML 配方，可随意改造"
                                   Classes="page-subtitle" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button Content="打开示例图目录"
                            Classes="gallery-action"
                            AutomationProperties.Name="打开示例图目录"
                            Command="{Binding OpenTemplateDirectoryCommand}" />
                    <Button Content="刷新"
                            Classes="gallery-action"
                            AutomationProperties.Name="刷新模板库"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,20,0,0" ColumnDefinitions="*,260,Auto" ColumnSpacing="14">
                <ItemsControl Grid.Column="0" ItemsSource="{Binding CategoryChoices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryChoiceViewModel">
                            <ToggleButton Content="{Binding Name}"
                                          Classes="gallery-chip"
                                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          Command="{Binding SelectCommand}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Grid.Column="1"
                         Classes="gallery-search"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="搜索模板"
                         PlaceholderText="搜索">
                    <TextBox.InnerLeftContent>
                        <controls:ZitieIcon Data="M11 4a7 7 0 1 0 7 7 7 7 0 0 0-7-7z M20 20l-3.5-3.5"
                                            IconSize="15"
                                            StrokeThickness="2"
                                            Foreground="{DynamicResource ZitieInkMutedBrush}"
                                            Margin="10,0,6,0" />
                    </TextBox.InnerLeftContent>
                </TextBox>
                <TextBlock Grid.Column="2"
                           Text="{Binding FilteredModuleCount, StringFormat={}{0} 个模板}"
                           Classes="gallery-count"
                           VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="26,18,26,0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="未找到匹配的模板"
                           Classes="module-empty"
                           IsVisible="{Binding IsEmpty}" />
                <ItemsControl ItemsSource="{Binding FilteredModules}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModuleCardViewModel">
                            <Button Classes="module-card"
                                    Width="{Binding CardWidth}"
                                    Height="{Binding CardHeight}"
                                    AutomationProperties.Name="{Binding Module.Name}"
                                    Command="{Binding OpenCommand}"
                                    CommandParameter="{Binding Module}">
                                <Grid RowDefinitions="Auto,*">
                                    <Border Grid.RowSpan="2" Classes="card-shadow-layer" />
                                    <Grid Grid.Row="0">
                                        <Border Classes="module-thumb"
                                                Height="{Binding ThumbHeight}">
                                            <Image Source="{Binding PreviewImage}"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False" />
                                        </Border>
                                        <Border Classes="module-tag">
                                            <TextBlock Text="{Binding CategoryText}"
                                                       Foreground="{DynamicResource ZitieAccentBrush}"
                                                       FontSize="{DynamicResource ZitieUiFontSizeTiny}" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Margin="4,10,4,4" Spacing="4">
                                        <TextBlock Text="{Binding Module.Name}"
                                                   Classes="module-card-title"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Module.Description}"
                                                   Classes="module-card-desc"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Margin="0,4,0,0">
                                            <Rectangle Height="1" Stroke="{DynamicResource ZitieBorderBrush}" StrokeDashArray="3,3" />
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                                                <Border Classes="module-card-dot" />
                                                <TextBlock Text="{Binding StatusText}" Classes="module-card-status" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.RowSpan="2" Classes="card-overlay">
                                        <TextBlock Text="开始生成 →" Classes="card-overlay-text" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Classes="gallery-status-bar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="{Binding CatalogSummary}"
                           Classes="gallery-count"
                           VerticalAlignment="Center" />
                <Grid Grid.Column="2"
                      ColumnDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="8"
                      VerticalAlignment="Center">
                    <TextBlock Text="缩放"
                               Classes="gallery-count"
                               VerticalAlignment="Center" />
                    <Slider Grid.Column="1"
                            Width="{StaticResource ZitieStageZoomSliderWidth}"
                            Classes="gallery-zoom"
                            AutomationProperties.Name="模板块缩放"
                            ToolTip.Tip="缩放模板块大小"
                            Minimum="{Binding MinimumZoom}"
                            Maximum="{Binding MaximumZoom}"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="True"
                            Value="{Binding GalleryZoom}" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding GalleryZoom, StringFormat={}{0:P0}}"
                               Classes="gallery-count"
                               MinWidth="{StaticResource ZitieStageZoomValueWidth}"
                               TextAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
