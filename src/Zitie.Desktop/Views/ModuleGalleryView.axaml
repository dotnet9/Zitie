<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Zitie.Desktop.ViewModels"
             xmlns:zitie="using:Zitie.Avalonia.Controls"
             x:Class="Zitie.Desktop.Views.ModuleGalleryView"
             x:DataType="vm:ModuleGalleryViewModel"
             Background="#F5F0E6"
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:prism="http://prismlibrary.com/">
    <Grid RowDefinitions="Auto,*" Background="#F5F0E6">
        <StackPanel Grid.Row="0" Margin="26,22,26,0" Spacing="0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="5">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
                        <TextBlock Text="模板库" Classes="page-title" />
                        <TextBlock Text="TEMPLATE GALLERY" Classes="page-title-en" />
                    </StackPanel>
                    <TextBlock Text="选择模板开始生成字帖 · 内置模板与自定义模板均为 JSON 配方，可随意改造"
                               Classes="page-subtitle" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button Content="打开模板目录"
                            Classes="gallery-action"
                            Command="{Binding OpenTemplateDirectoryCommand}" />
                    <Button Content="刷新"
                            Classes="gallery-action"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,18,0,0" ColumnDefinitions="300,*,Auto" ColumnSpacing="14">
                <TextBox Grid.Column="0"
                         Classes="gallery-search"
                         Text="{Binding SearchText}"
                         PlaceholderText="搜索模板名称、说明或分类" />
                <ItemsControl Grid.Column="1" ItemsSource="{Binding CategoryChoices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryChoiceViewModel">
                            <ToggleButton Content="{Binding Name}"
                                          Classes="gallery-chip"
                                          IsChecked="{Binding IsSelected}"
                                          Click="CategoryButton_OnClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Column="2"
                           Text="{Binding FilteredModuleCount, StringFormat={}{0} 个模板}"
                           Classes="gallery-count"
                           VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="26,16,26,0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="未找到匹配的模板"
                           Classes="module-empty"
                           IsVisible="{Binding IsEmpty}" />
                <ItemsControl ItemsSource="{Binding FilteredModules}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModuleCardViewModel">
                            <Button Classes="module-card"
                                    Command="{Binding OpenCommand}"
                                    CommandParameter="{Binding Module}">
                                <Grid RowDefinitions="190,*">
                                    <Grid Grid.Row="0">
                                        <Border Classes="module-thumb">
                                            <zitie:ZitiePreview Spec="{Binding PreviewSpec}"
                                                               Pages="{Binding PreviewPages}"
                                                               PageIndex="0"
                                                               Zoom="{Binding PreviewZoom}"
                                                               HorizontalContentAlignment="Center"
                                                               VerticalContentAlignment="Center"
                                                               IsHitTestVisible="False" />
                                        </Border>
                                        <Border Classes="module-tag">
                                            <TextBlock Text="{Binding CategoryText}"
                                                       Foreground="#B04A3F"
                                                       FontSize="11" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Margin="4,10,4,4" Spacing="4">
                                        <TextBlock Text="{Binding Module.Name}"
                                                   Classes="module-card-title"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Module.Description}"
                                                   Classes="module-card-desc"
                                                   TextWrapping="Wrap" />
                                        <Border Margin="0,4,0,0"
                                                BorderBrush="#E8E0D0"
                                                BorderThickness="0,1,0,0"
                                                Padding="0,8,0,0">
                                            <TextBlock Text="{Binding StatusText}"
                                                       Classes="module-card-status" />
                                        </Border>
                                    </StackPanel>
                                    <Border Grid.RowSpan="2" Classes="card-overlay">
                                        <TextBlock Text="开始生成 →" Classes="card-overlay-text" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
