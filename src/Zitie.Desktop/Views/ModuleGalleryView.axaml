<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:vm="using:Zitie.Desktop.ViewModels"
             xmlns:zitie="using:Zitie.Avalonia.Controls"
             x:Class="Zitie.Desktop.Views.ModuleGalleryView"
             x:DataType="vm:ModuleGalleryViewModel"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <ScrollViewer>
        <StackPanel Margin="24,20" Spacing="18">
            <TextBlock Text="选择字帖模板" Classes="page-title" />
            <TextBlock Text="点击模板开始生成字帖；模板是 modules 目录下的 JSON 配方，可自行增删替换。"
                       Classes="page-subtitle" />

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <TextBox Grid.Column="0"
                         Classes="gallery-search"
                         Text="{Binding SearchText}"
                         PlaceholderText="搜索模板名称、说明或分类" />
                <ComboBox Grid.Column="1"
                          Width="150"
                          ItemsSource="{Binding CategoryChoices}"
                          SelectedItem="{Binding SelectedCategory}" />
                <TextBlock Grid.Column="2"
                           Text="{Binding FilteredModuleCount, StringFormat={}{0} 个模板}"
                           Classes="gallery-count"
                           VerticalAlignment="Center" />
            </Grid>

            <TextBlock Text="未找到匹配的模板"
                       Classes="module-empty"
                       IsVisible="{Binding IsEmpty}" />

            <ItemsControl ItemsSource="{Binding FilteredModules}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModuleCardViewModel">
                        <Button Classes="module-card"
                                Command="{Binding OpenCommand}"
                                CommandParameter="{Binding Module}">
                            <StackPanel Width="226" Spacing="7">
                                <zitie:ZitiePreview Spec="{Binding PreviewSpec}"
                                                   Pages="{Binding PreviewPages}"
                                                   PageIndex="0"
                                                   Zoom="{Binding PreviewZoom}"
                                                   Width="226"
                                                   Height="304"
                                                   IsHitTestVisible="False" />
                                <TextBlock Text="{Binding CategoryText}"
                                           Classes="module-card-category" />
                                <TextBlock Text="{Binding Module.Name}" Classes="module-card-title" />
                                <TextBlock Text="{Binding Module.Description}"
                                           Classes="module-card-desc"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusText}" Classes="module-card-status" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
