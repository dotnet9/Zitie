<zitie:ZitieWindow xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:prism="http://prismlibrary.com/"
                   xmlns:zitie="using:Zitie.Desktop.Controls"
                   xmlns:vm="using:Zitie.Desktop.ViewModels"
                   x:Class="Zitie.Desktop.Views.MainWindow"
                   x:DataType="vm:MainWindowViewModel"
                   prism:ViewModelLocator.AutoWireViewModel="True"
                   Title="字帖 Zitie"
                   Width="1240"
                   Height="840"
                   MinWidth="1000"
                   MinHeight="680"
                   CanResize="True"
                   CanMaximize="True"
                   Icon="avares://Zitie.Desktop/Assets/logo.ico"
                   Background="{DynamicResource ZitiePaperBrush}"
                   FontFamily="{DynamicResource ZitieUiFontFamily}"
                   WindowStartupLocation="CenterScreen">
    <zitie:ZitieWindow.LeftContent>
        <StackPanel Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="9">
            <Border Classes="window-seal">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource ZitieUiFontSizeMedium}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource ZitieLightTextBrush}"
                           Text="字" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock Classes="window-title" Text="字帖" />
                <TextBlock Classes="window-title-en" Text="ZITIE WORKSHOP" />
            </StackPanel>
        </StackPanel>
    </zitie:ZitieWindow.LeftContent>

    <zitie:ZitieWindow.TitleBarContent>
        <StackPanel Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
            <TextBlock Classes="window-center-title"
                       VerticalAlignment="Center"
                       Text="字帖工作台" />
            <Border Classes="device-divider" />
            <TextBlock Classes="device-label"
                       VerticalAlignment="Center"
                       Text="字号" />
            <Grid ColumnDefinitions="120,Auto"
                  ColumnSpacing="8"
                  VerticalAlignment="Center">
                <Slider Classes="device-font-slider"
                        AutomationProperties.Name="软件字号"
                        ToolTip.Tip="调整软件界面字号"
                        Minimum="{Binding MinimumUiFontSize}"
                        Maximum="{Binding MaximumUiFontSize}"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Value="{Binding UiFontSize}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding UiFontSize, StringFormat={}{0:0}}"
                           Classes="device-value"
                           VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
    </zitie:ZitieWindow.TitleBarContent>

    <Grid ColumnDefinitions="64,*" Background="{DynamicResource ZitiePaperBrush}">
        <Border Grid.Column="0" Classes="app-rail">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                    <Border Classes="app-seal">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource ZitieUiFontSizeSeal}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource ZitieLightTextBrush}"
                                   Text="字" />
                    </Border>
                    <Button Classes="rail-button"
                            Classes.active="{Binding IsGalleryMode}"
                            Command="{Binding NavigateGalleryCommand}"
                            AutomationProperties.Name="模板库"
                            ToolTip.Tip="模板库">
                        <Grid Width="42" Height="42">
                            <Border Classes="rail-active-marker" />
                            <zitie:ZitieIcon Data="M3,3 H10.5 V10.5 H3 Z M13.5,3 H21 V10.5 H13.5 Z M3,13.5 H10.5 V21 H3 Z M13.5,13.5 H21 V21 H13.5 Z"
                                              IconSize="21"
                                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Grid>
                    </Button>
                    <Button Classes="rail-button"
                            Classes.active="{Binding !IsGalleryMode}"
                            Command="{Binding NavigateEditorCommand}"
                            AutomationProperties.Name="新建字帖"
                            ToolTip.Tip="新建字帖">
                        <Grid Width="42" Height="42">
                            <Border Classes="rail-active-marker" />
                            <zitie:ZitieIcon Data="M12,5 V19 M5,12 H19"
                                              IconSize="21"
                                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Grid>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center">
                    <Button Classes="rail-button"
                            Command="{Binding ToggleLogCommand}"
                            AutomationProperties.Name="显示或隐藏日志"
                            ToolTip.Tip="日志">
                        <zitie:ZitieIcon Data="M6,3 H15 L19,7 V21 H6 Z M9,11 H16 M9,15 H16 M9,7 H12"
                                          IconSize="21"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="*,Auto">
            <ContentControl Grid.Row="0" prism:RegionManager.RegionName="MainRegion" />

            <Border Grid.Row="1"
                    Classes="log-panel"
                    IsVisible="{Binding IsLogVisible}">
                <DockPanel>
                    <Border Padding="12,6" DockPanel.Dock="Top">
                        <DockPanel>
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="日志" />
                            <Button Classes="gallery-action"
                                    Command="{Binding ToggleLogCommand}"
                                    Content="关闭"
                                    DockPanel.Dock="Right" />
                        </DockPanel>
                    </Border>
                    <ContentControl Margin="8,0,8,8" Content="{Binding LogView}" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</zitie:ZitieWindow>
