<codewf:CodeWFWindow xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="https://codewf.com" xmlns:q="using:Zitie.Desktop.I18n"
                   xmlns:prism="http://prismlibrary.com/"
                   xmlns:zitie="using:Zitie.Desktop.Controls"
                   xmlns:codewf="https://codewf.com"
                   xmlns:vm="using:Zitie.Desktop.ViewModels"
                   xmlns:ursa="https://irihi.tech/ursa"
                   x:Class="Zitie.Desktop.Views.MainWindow"
                   x:DataType="vm:MainWindowViewModel"
                   prism:ViewModelLocator.AutoWireViewModel="True"
                   Title="{l:I18n {x:Static q:Language.WindowTitle}}"
                   Width="1240"
                   Height="840"
                   MinWidth="1000"
                   MinHeight="680"
                   CanResize="True"
                   CanMaximize="True"
                   Icon="avares://Zitie.Desktop/Assets/logo.ico"
                   Background="{DynamicResource ZitiePaperBrush}"
                   FontFamily="{DynamicResource ZitieUiFontFamily}"
                   WindowStartupLocation="CenterScreen"
                   TitleBarHeight="44">
    <Window.Styles>
        <Style Selector="ListBox.title-palettes ListBoxItem"><Setter Property="Width" Value="24" /><Setter Property="Height" Value="28" /><Setter Property="Padding" Value="4" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" /></Style>
        <Style Selector="ListBox.title-palettes ListBoxItem:selected"><Setter Property="BorderBrush" Value="{DynamicResource ZitieAccentBrush}" /></Style>
    </Window.Styles>
    <codewf:CodeWFWindow.LeftContent>
        <StackPanel Margin="14,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="9">
            <Border Classes="window-seal">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource ZitieUiFontSizeMedium}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource ZitieLightTextBrush}"
                           Text="{l:I18n {x:Static q:Language.SealCharacter}}" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock Classes="window-title" Text="{l:I18n {x:Static q:Language.ProductName}}" />
                <TextBlock Classes="window-title-en" Text="ZITIE WORKSHOP" />
            </StackPanel>
        </StackPanel>
    </codewf:CodeWFWindow.LeftContent>

    <codewf:CodeWFWindow.TitleBarContent>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ListBox Classes="title-palettes" ItemsSource="{Binding Appearance.Palettes}" SelectedItem="{Binding Appearance.SelectedPalette}" Height="28" Padding="0" BorderThickness="0" Background="Transparent" ToolTip.Tip="{l:I18n {x:Static q:Language.Palette}}">
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate><DataTemplate x:DataType="vm:AppearanceChoice"><Ellipse Width="14" Height="14" Fill="{Binding Swatch}" ToolTip.Tip="{Binding Text}" AutomationProperties.Name="{Binding Text}" /></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <ThemeVariantScope x:Name="TitleBarThemeScope" DataContext="{Binding Appearance}" x:DataType="vm:AppearanceViewModel" RequestedThemeVariant="{Binding ThemeMode, Mode=TwoWay, Converter={x:Static codewf:StudioThemeModeConverter.Instance}}">
                <ThemeVariantScope.Resources>
                    <TextBlock x:Key="STRING_THEME_TOGGLE_SYSTEM" Text="{l:I18n {x:Static q:Language.SystemMode}}" />
                    <TextBlock x:Key="STRING_THEME_TOGGLE_LIGHT" Text="{l:I18n {x:Static q:Language.LightMode}}" />
                    <TextBlock x:Key="STRING_THEME_TOGGLE_DARK" Text="{l:I18n {x:Static q:Language.DarkMode}}" />
                </ThemeVariantScope.Resources>
                <ursa:ThemeToggleButton Width="30" Height="30" IsThreeState="True" TargetScope="{Binding #TitleBarThemeScope}" ToolTip.Tip="{l:I18n {x:Static q:Language.ThemeMode}}" />
            </ThemeVariantScope>
            <Button Width="30" Height="30" Padding="6" Background="Transparent" ToolTip.Tip="{l:I18n {x:Static q:Language.LanguageName}}" AutomationProperties.Name="{l:I18n {x:Static q:Language.LanguageName}}">
                <PathIcon Width="17" Height="17" Data="{StaticResource SemiIconLanguage}" />
                <Button.Flyout><MenuFlyout ItemsSource="{Binding Appearance.Languages}"><MenuFlyout.ItemContainerTheme>
                    <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:AppearanceChoice"><Setter Property="Header" Value="{Binding Text}" /><Setter Property="Command" Value="{Binding SelectCommand}" /></ControlTheme>
                </MenuFlyout.ItemContainerTheme></MenuFlyout></Button.Flyout>
            </Button>
            <Border Classes="device-divider" />
            <TextBlock Classes="device-label" VerticalAlignment="Center" Text="{l:I18n {x:Static q:Language.FontSize}}" />
            <Slider Width="80" Classes="device-font-slider" AutomationProperties.Name="{l:I18n {x:Static q:Language.InterfaceFontSize}}" Minimum="{Binding MinimumUiFontSize}" Maximum="{Binding MaximumUiFontSize}" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding UiFontSize}" />
            <TextBlock Text="{Binding UiFontSize, StringFormat={}{0:0}}" Classes="device-value" VerticalAlignment="Center" />
        </StackPanel>
    </codewf:CodeWFWindow.TitleBarContent>

    <Grid ColumnDefinitions="64,*" Background="{DynamicResource ZitiePaperBrush}">
        <Border Grid.Column="0" Classes="app-rail">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                    <Button Classes="rail-button"
                            Classes.active="{Binding IsGalleryMode}"
                            Command="{Binding NavigateGalleryCommand}"
                            AutomationProperties.Name="{l:I18n {x:Static q:Language.TemplateGallery}}"
                            ToolTip.Tip="{l:I18n {x:Static q:Language.TemplateGallery}}">
                        <Grid Width="42" Height="42">
                            <Border Classes="rail-active-marker" />
                            <zitie:ZitieIcon Data="M3,3 H10.5 V10.5 H3 Z M13.5,3 H21 V10.5 H13.5 Z M3,13.5 H10.5 V21 H3 Z M13.5,13.5 H21 V21 H13.5 Z"
                                              IconSize="21"
                                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Grid>
                    </Button>
                    <Button Classes="rail-button"
                            Classes.active="{Binding !IsGalleryMode}"
                            Command="{Binding NavigateEditorCommand}"
                            AutomationProperties.Name="{l:I18n {x:Static q:Language.NewSheet}}"
                            ToolTip.Tip="{l:I18n {x:Static q:Language.NewSheet}}">
                        <Grid Width="42" Height="42">
                            <Border Classes="rail-active-marker" />
                            <zitie:ZitieIcon Data="M12,5 V19 M5,12 H19"
                                              IsVisible="{Binding IsGalleryMode}"
                                              IconSize="21"
                                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <zitie:ZitieIcon Data="M12,20 H20 M15,4 L20,9 L10.5,18.5 A2,2 0 0 1 9.5,19 L5,20 L6,15.5 A2,2 0 0 1 6.5,14.5 Z"
                                              IsVisible="{Binding !IsGalleryMode}"
                                              IconSize="21"
                                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Grid>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center">
                    <Button Classes="rail-button"
                            Command="{Binding ToggleLogCommand}"
                            AutomationProperties.Name="{l:I18n {x:Static q:Language.ToggleLog}}"
                            ToolTip.Tip="{l:I18n {x:Static q:Language.Log}}">
                        <zitie:ZitieIcon Data="M6,3 H15 L19,7 V21 H6 Z M9,11 H16 M9,15 H16 M9,7 H12"
                                          IconSize="21"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <Button Classes="rail-button"
                            Click="OnShowAbout"
                            AutomationProperties.Name="{l:I18n {x:Static q:Language.About}}"
                            ToolTip.Tip="{l:I18n {x:Static q:Language.About}}">
                        <zitie:ZitieIcon Data="M12,3 A9,9 0 1 0 12,21 A9,9 0 1 0 12,3 M12,11 V17 M12,7 V8"
                                          IconSize="21"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="*,Auto">
            <ContentControl Grid.Row="0" prism:RegionManager.RegionName="MainRegion" />

            <Border Grid.Row="1"
                    Classes="log-panel"
                    IsVisible="{Binding IsLogVisible}">
                <DockPanel>
                    <Border Padding="12,6" DockPanel.Dock="Top">
                        <DockPanel>
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{l:I18n {x:Static q:Language.Log}}" />
                            <Button Classes="gallery-action"
                                    Command="{Binding ToggleLogCommand}"
                                    Content="{l:I18n {x:Static q:Language.Close}}"
                                    DockPanel.Dock="Right" />
                        </DockPanel>
                    </Border>
                    <ContentControl Margin="8,0,8,8" Content="{Binding LogView}" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</codewf:CodeWFWindow>
