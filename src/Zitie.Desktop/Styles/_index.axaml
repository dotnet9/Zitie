<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 页面级 -->
    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="TextBlock.page-subtitle">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#6B6E76" />
    </Style>

    <Style Selector="TextBlock.section-title">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style Selector="Border.settings-section">
        <Setter Property="Padding" Value="0,0,0,12" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="BorderBrush" Value="#E5E6EB" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="TextBlock.settings-section-title">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#2C2D31" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style Selector="TextBox.gallery-search">
        <Setter Property="MinWidth" Value="280" />
        <Setter Property="Height" Value="36" />
    </Style>

    <Style Selector="TextBlock.gallery-count">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#6B6E76" />
    </Style>

    <Style Selector="TextBlock.module-empty">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#6B6E76" />
        <Setter Property="Margin" Value="2,6,0,0" />
    </Style>

    <!-- 模块卡片 -->
    <Style Selector="Button.module-card">
        <Setter Property="Width" Value="252" />
        <Setter Property="Height" Value="468" />
        <Setter Property="Margin" Value="0,0,14,14" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#E5E6EB" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.module-card:pointerover">
        <Setter Property="Background" Value="#FBF7F5" />
        <Setter Property="BorderBrush" Value="#D28C83" />
    </Style>

    <Style Selector="Button.module-card:disabled">
        <Setter Property="Opacity" Value="0.55" />
    </Style>

    <Style Selector="TextBlock.module-card-title">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.module-card-category">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#B04A3F" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style Selector="TextBlock.module-card-desc">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#6B6E76" />
        <Setter Property="MaxHeight" Value="34" />
    </Style>

    <Style Selector="TextBlock.module-card-status">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#B04A3F" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- 编辑页 -->
    <Style Selector="Border.toolbar">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#E5E6EB" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="Border.config-panel">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#E5E6EB" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <!-- 日志面板 -->
    <Style Selector="Border.log-panel">
        <Setter Property="Height" Value="240" />
        <Setter Property="Background" Value="#FBFBFA" />
        <Setter Property="BorderBrush" Value="#E5E6EB" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

</Styles>
