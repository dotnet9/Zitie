<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Themes/Tokens/ZitiePalette.axaml" />
                <ResourceInclude Source="/Themes/Tokens/ZitieMetrics.axaml" />
                <ResourceInclude Source="/Themes/Tokens/ZitieEffects.axaml" />
                <ResourceInclude Source="/Themes/Tokens/SemiThemeOverrides.axaml" />
                <ResourceInclude Source="/Themes/Controls/ZitieIcon.axaml" />
                <ResourceInclude Source="/Themes/Controls/ZitieWindow.axaml" />
                <ResourceInclude Source="/Themes/Controls/ZitieToolButton.axaml" />
                <ResourceInclude Source="/Themes/Controls/ZitieStepper.axaml" />
                <ResourceInclude Source="/Themes/Controls/ZitieEditorTabItem.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <StyleInclude Source="/Themes/Styles/ShellStyles.axaml" />
    <StyleInclude Source="/Themes/Styles/GalleryStyles.axaml" />
    <StyleInclude Source="/Themes/Styles/EditorStyles.axaml" />
</Styles>
