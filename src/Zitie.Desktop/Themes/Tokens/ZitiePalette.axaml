<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 应用界面读取共享主题令牌；实际字帖纸张保持独立打印配色。 -->
    <SolidColorBrush x:Key="ZitiePaperBrush" Color="{DynamicResource StudioSurfaceColor}" />
    <SolidColorBrush x:Key="ZitiePanelBrush" Color="{DynamicResource StudioBackgroundColor}" />
    <SolidColorBrush x:Key="ZitieRailBrush" Color="{DynamicResource StudioSurfaceColor}" />
    <SolidColorBrush x:Key="ZitieBorderBrush" Color="{DynamicResource StudioBorderColor}" />
    <SolidColorBrush x:Key="ZitieBorderStrongBrush" Color="{DynamicResource StudioBorderColor}" />
    <SolidColorBrush x:Key="ZitieInkBrush" Color="{DynamicResource StudioTextColor}" />
    <SolidColorBrush x:Key="ZitieInkSecondaryBrush" Color="{DynamicResource StudioMutedColor}" />
    <SolidColorBrush x:Key="ZitieInkMutedBrush" Color="{DynamicResource StudioMutedColor}" />
    <SolidColorBrush x:Key="ZitieAccentBrush" Color="{DynamicResource StudioAccentColor}" />
    <SolidColorBrush x:Key="ZitieAccentHoverBrush" Color="{DynamicResource StudioSecondaryColor}" />
    <SolidColorBrush x:Key="ZitieAccentDarkBrush" Color="{DynamicResource StudioAccentColor}" />
    <SolidColorBrush x:Key="ZitieAccentTintBrush" Color="{DynamicResource StudioRaisedColor}" />
    <SolidColorBrush x:Key="ZitieAccentPressedBrush" Color="{DynamicResource StudioRaisedColor}" />
    <SolidColorBrush x:Key="ZitieAccentDisabledBrush" Color="{DynamicResource StudioBorderColor}" />
    <SolidColorBrush x:Key="ZitieInputBrush" Color="{DynamicResource StudioBackgroundColor}" />
    <SolidColorBrush x:Key="ZitieTextSelectionBrush" Color="{DynamicResource StudioAccentColor}" Opacity="0.28" />
    <SolidColorBrush x:Key="ZitieTagBrush" Color="{DynamicResource StudioRaisedColor}" />
    <SolidColorBrush x:Key="ZitieThumbnailBorderBrush" Color="{DynamicResource StudioBorderColor}" />
    <SolidColorBrush x:Key="ZitiePreviewStageBrush" Color="{DynamicResource StudioRaisedColor}" />
    <SolidColorBrush x:Key="ZitieStageBarBrush" Color="{DynamicResource StudioSurfaceColor}" />
    <SolidColorBrush x:Key="ZitieLightTextBrush" Color="White" />
    <SolidColorBrush x:Key="ZitieThumbnailBrush" Color="#FDFBF6" />
    <SolidColorBrush x:Key="ZitieSuccessBrush" Color="#7BA05B" />
    <SolidColorBrush x:Key="ZitieOverlayBrush" Color="#702B2722" />
</ResourceDictionary>
