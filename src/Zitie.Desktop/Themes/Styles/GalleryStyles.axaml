<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="{DynamicResource ZitieUiFontSizeTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource ZitieInkBrush}" />
    </Style>
    <Style Selector="TextBlock.page-subtitle">
        <Setter Property="FontSize" Value="{DynamicResource ZitieUiFontSizeBase}" />
        <Setter Property="Foreground" Value="{DynamicResource ZitieInkSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.page-title-en">
        <Setter Property="FontSize" Value="{DynamicResource ZitieUiFontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource ZitieInkMutedBrush}" />
        <Setter Property="LetterSpacing" Value="3" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Border.page-title-accent">
        <Setter Property="Width" Value="5" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{DynamicResource ZitieAccentBrush}" />
        <Setter Property="BoxShadow" Value="0 2 6 #4DB04A3F" />
    </Style>

    <Style Selector="Button.gallery-action">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource ZitiePanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ZitieBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource ZitieInkSecondaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource ZitieUiFontSizeBase}" />
    </Style>
    <Style Selector="Button.gallery-action:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource ZitieAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ZitieAccentBrush}" />
    </Style>
    <Style Selector="Button.gallery-action:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource ZitieAccentBrush}" />
    </Style>
    <Style Selector="TextBox.gallery-search">
        <Setter Property="MinWidth" Value="240" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="4,0,12,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource ZitiePanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ZitieBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{DynamicResource ZitieUiFontSizeBase}" />
    </Style>
    <Style Selector="TextBox.gallery-search:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource ZitieAccentBrush}" />
    </Style>
    <Style Selector="Slider.gallery-zoom">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.gallery-status-bar">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Background" Value="{DynamicResource ZitieRailBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ZitieBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="TextBlock.gallery-count">
        <Setter Property="FontSize" Value="{DynamicResource ZitieUiFontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource ZitieInkMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.gallery-path">
        <Setter Property="FontSize" Value="{DynamicResource ZitieUiFontSizeTiny}" />
        <Setter Property="Foreground" Value="{DynamicResource ZitieInkMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.module-empty">
        <Setter Property="FontSize" Value="{DynamicResource ZitieUiFontSizeBase}" />
        <Setter Property="Foreground" Value="{DynamicResource ZitieInkSecondaryBrush}" />
        <Setter Property="Margin" Value="2,6,0,0" />
    </Style>

    <Style Selector="Button.gallery-chip">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource ZitieInkSecondaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource ZitieUiFontSizeSmall}" />
    </Style>
    <Style Selector="Button.gallery-chip:pointerover">
        <Setter Property="Background" Value="{DynamicResource ZitieAccentTintBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ZitieAccentBrush}" />
    </Style>
    <Style Selector="Button.gallery-chip.selected">
        <Setter Property="Background" Value="{DynamicResource ZitieAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ZitieLightTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.gallery-chip:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource ZitieAccentBrush}" />
    </Style>
    <Style Selector="ToggleButton.gallery-chip">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource ZitieInkSecondaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource ZitieUiFontSizeSmall}" />
    </Style>
    <Style Selector="ToggleButton.gallery-chip:pointerover">
        <Setter Property="Background" Value="{DynamicResource ZitieAccentTintBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ZitieAccentBrush}" />
    </Style>
    <Style Selector="ToggleButton.gallery-chip:checked">
        <Setter Property="Background" Value="{DynamicResource ZitieAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ZitieLightTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ToggleButton.gallery-chip:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource ZitieAccentBrush}" />
    </Style>

    <Style Selector="Button.module-card">
        <Setter Property="Width" Value="260" />
        <Setter Property="Height" Value="320" />
        <Setter Property="Margin" Value="0,0,16,16" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource ZitiePanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ZitieBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource ZitieInkBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.module-card:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource ZitieAccentDisabledBrush}" />
        <Setter Property="Background" Value="{DynamicResource ZitiePanelBrush}" />
    </Style>
    <Style Selector="Button.module-card:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource ZitieAccentBrush}" />
    </Style>
    <Style Selector="Border.card-shadow-layer">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BoxShadow" Value="{StaticResource ZitieCardShadow}" />
    </Style>
    <Style Selector="Button.module-card:pointerover Border.card-shadow-layer">
        <Setter Property="BoxShadow" Value="{StaticResource ZitieCardHoverShadow}" />
    </Style>
    <Style Selector="Border.module-thumb">
        <Setter Property="Height" Value="190" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{DynamicResource ZitieThumbnailBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.module-tag">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Background" Value="{DynamicResource ZitieTagBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ZitieAccentDisabledBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="ZIndex" Value="2" />
    </Style>
    <Style Selector="TextBlock.module-card-category">
        <Setter Property="FontSize" Value="{DynamicResource ZitieUiFontSizeTiny}" />
        <Setter Property="Foreground" Value="{DynamicResource ZitieAccentBrush}" />
    </Style>
    <Style Selector="TextBlock.module-card-title">
        <Setter Property="FontSize" Value="{DynamicResource ZitieUiFontSizeLarge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ZitieInkBrush}" />
    </Style>
    <Style Selector="TextBlock.module-card-desc">
        <Setter Property="FontSize" Value="{DynamicResource ZitieUiFontSizeTiny}" />
        <Setter Property="Foreground" Value="{DynamicResource ZitieInkSecondaryBrush}" />
        <Setter Property="MaxHeight" Value="34" />
    </Style>
    <Style Selector="TextBlock.module-card-status">
        <Setter Property="FontSize" Value="{DynamicResource ZitieUiFontSizeTiny}" />
        <Setter Property="Foreground" Value="{DynamicResource ZitieInkMutedBrush}" />
    </Style>
    <Style Selector="Border.module-card-dot">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{DynamicResource ZitieSuccessBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.card-overlay">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Background" Value="{DynamicResource ZitieOverlayBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="ZIndex" Value="3" />
    </Style>
    <Style Selector="Button.module-card:pointerover Border.card-overlay">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TextBlock.card-overlay-text">
        <Setter Property="Foreground" Value="{DynamicResource ZitieLightTextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource ZitieUiFontSizeMedium}" />
        <Setter Property="LetterSpacing" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</Styles>
