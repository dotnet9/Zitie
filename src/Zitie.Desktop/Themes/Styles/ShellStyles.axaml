<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Window">
        <Setter Property="Foreground" Value="{DynamicResource ZitieInkBrush}" />
    </Style>

    <Style Selector="Border.window-seal">
        <Setter Property="Width" Value="25" />
        <Setter Property="Height" Value="25" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="{DynamicResource ZitieAccentBrush}" />
    </Style>
    <Style Selector="TextBlock.window-title">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ZitieInkBrush}" />
    </Style>
    <Style Selector="TextBlock.window-title-en">
        <Setter Property="FontSize" Value="8" />
        <Setter Property="Foreground" Value="{DynamicResource ZitieInkMutedBrush}" />
        <Setter Property="LetterSpacing" Value="1.5" />
    </Style>
    <Style Selector="TextBlock.window-center-title">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource ZitieInkMutedBrush}" />
    </Style>

    <Style Selector="Border.app-rail">
        <Setter Property="Background" Value="{DynamicResource ZitieRailBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ZitieBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Padding" Value="0,14,0,16" />
    </Style>
    <Style Selector="Border.app-seal">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="{DynamicResource ZitieAccentBrush}" />
        <Setter Property="BoxShadow" Value="{StaticResource ZitieSealShadow}" />
        <Setter Property="Margin" Value="0,0,0,26" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.rail-button">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource ZitieInkMutedBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.rail-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource ZitieAccentTintBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ZitieInkSecondaryBrush}" />
    </Style>
    <Style Selector="Button.rail-button.active">
        <Setter Property="Background" Value="{DynamicResource ZitieAccentTintBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ZitieAccentBrush}" />
    </Style>
    <Style Selector="Button.rail-button:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource ZitieAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.rail-active-marker">
        <Setter Property="Width" Value="3" />
        <Setter Property="Height" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{DynamicResource ZitieAccentBrush}" />
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.rail-button.active Border.rail-active-marker">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="Border.log-panel">
        <Setter Property="Height" Value="240" />
        <Setter Property="Background" Value="{DynamicResource ZitieRailBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ZitieBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
</Styles>
