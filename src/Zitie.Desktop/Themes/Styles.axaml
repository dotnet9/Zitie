<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Window">
        <Setter Property="Foreground" Value="{DynamicResource ZitieInkBrush}" />
    </Style>

    <Style Selector="Border.window-seal">
        <Setter Property="Width" Value="25" />
        <Setter Property="Height" Value="25" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="{DynamicResource ZitieAccentBrush}" />
    </Style>
    <Style Selector="TextBlock.window-title">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ZitieInkBrush}" />
    </Style>
    <Style Selector="TextBlock.window-title-en">
        <Setter Property="FontSize" Value="8" />
        <Setter Property="Foreground" Value="{DynamicResource ZitieInkMutedBrush}" />
        <Setter Property="LetterSpacing" Value="1.5" />
    </Style>
    <Style Selector="TextBlock.window-center-title">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource ZitieInkMutedBrush}" />
    </Style>

    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#2B2722" />
    </Style>
    <Style Selector="TextBlock.page-subtitle">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#6E675D" />
    </Style>
    <Style Selector="TextBlock.page-title-en">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#A29886" />
        <Setter Property="LetterSpacing" Value="3" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style Selector="Border.app-rail">
        <Setter Property="Background" Value="#FBF8F1" />
        <Setter Property="BorderBrush" Value="#E8E0D0" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Padding" Value="0,14,0,16" />
    </Style>
    <Style Selector="Border.app-seal">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="#B04A3F" />
        <Setter Property="BoxShadow" Value="0 3 8 #59B04A3F" />
        <Setter Property="Margin" Value="0,0,0,26" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.rail-button">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#A29886" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.rail-button:pointerover">
        <Setter Property="Background" Value="#F7EBE7" />
        <Setter Property="Foreground" Value="#6E675D" />
    </Style>
    <Style Selector="Button.rail-button.active">
        <Setter Property="Background" Value="#F7EBE7" />
        <Setter Property="Foreground" Value="#B04A3F" />
    </Style>
    <Style Selector="Button.rail-button Path">
        <Setter Property="Stroke" Value="#A29886" />
    </Style>
    <Style Selector="Button.rail-button.active Path">
        <Setter Property="Stroke" Value="#B04A3F" />
    </Style>
    <Style Selector="Border.rail-active-marker">
        <Setter Property="Width" Value="3" />
        <Setter Property="Height" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="#B04A3F" />
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.rail-button.active Border.rail-active-marker">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="Button.gallery-action">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#D9CFBA" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#6E675D" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.gallery-action:pointerover">
        <Setter Property="BorderBrush" Value="#B04A3F" />
        <Setter Property="Foreground" Value="#B04A3F" />
    </Style>
    <Style Selector="TextBox.gallery-search">
        <Setter Property="MinWidth" Value="300" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="4,0,12,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#D9CFBA" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBox.gallery-search:focus">
        <Setter Property="BorderBrush" Value="#B04A3F" />
    </Style>
    <Style Selector="TextBlock.gallery-count">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#A29886" />
    </Style>
    <Style Selector="TextBlock.gallery-path">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#A29886" />
    </Style>
    <Style Selector="TextBlock.module-empty">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#6E675D" />
        <Setter Property="Margin" Value="2,6,0,0" />
    </Style>

    <Style Selector="Button.gallery-chip">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#6E675D" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="Button.gallery-chip:pointerover">
        <Setter Property="Background" Value="#F7EBE7" />
        <Setter Property="Foreground" Value="#B04A3F" />
    </Style>
    <Style Selector="Button.gallery-chip.selected">
        <Setter Property="Background" Value="#B04A3F" />
        <Setter Property="Foreground" Value="#FBF6EF" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ToggleButton.gallery-chip">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#6E675D" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="ToggleButton.gallery-chip:pointerover">
        <Setter Property="Background" Value="#F7EBE7" />
        <Setter Property="Foreground" Value="#B04A3F" />
    </Style>
    <Style Selector="ToggleButton.gallery-chip:checked">
        <Setter Property="Background" Value="#B04A3F" />
        <Setter Property="Foreground" Value="#FBF6EF" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.module-card">
        <Setter Property="Width" Value="260" />
        <Setter Property="Height" Value="320" />
        <Setter Property="Margin" Value="0,0,16,16" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#E8E0D0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#2B2722" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.module-card:pointerover">
        <Setter Property="BorderBrush" Value="#D9A7A0" />
        <Setter Property="Background" Value="#FFFFFF" />
    </Style>
    <!-- 卡片阴影由独立图层承担（Button 本身无 BoxShadow 属性），悬停加深模拟上浮 -->
    <Style Selector="Border.card-shadow-layer">
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BoxShadow" Value="0 1 2 #0D2B2722, 0 6 18 #122B2722" />
    </Style>
    <Style Selector="Button.module-card:pointerover Border.card-shadow-layer">
        <Setter Property="BoxShadow" Value="0 2 4 #0F2B2722, 0 14 32 #212B2722" />
    </Style>
    <Style Selector="Border.module-thumb">
        <Setter Property="Height" Value="190" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="#FDFBF6" />
        <Setter Property="BorderBrush" Value="#EFE8D8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Border.module-tag">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Background" Value="#FDF8F1" />
        <Setter Property="BorderBrush" Value="#D9A7A0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="ZIndex" Value="2" />
    </Style>
    <Style Selector="TextBlock.module-card-category">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#B04A3F" />
    </Style>
    <Style Selector="TextBlock.module-card-title">
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#2B2722" />
    </Style>
    <Style Selector="TextBlock.module-card-desc">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="#6E675D" />
        <Setter Property="MaxHeight" Value="34" />
    </Style>
    <Style Selector="TextBlock.module-card-status">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#A29886" />
    </Style>
    <Style Selector="Border.module-card-dot">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="#7BA05B" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.card-overlay">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Background" Value="#702B2722" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="ZIndex" Value="3" />
    </Style>
    <Style Selector="Button.module-card:pointerover Border.card-overlay">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TextBlock.card-overlay-text">
        <Setter Property="Foreground" Value="#FBF6EF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LetterSpacing" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.editor-toolbar">
        <Setter Property="Height" Value="50" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#E8E0D0" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Button.editor-icon-button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#D9CFBA" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#6E675D" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.editor-icon-button Path.back-glyph">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.editor-icon-button:pointerover">
        <Setter Property="Background" Value="#F7EBE7" />
        <Setter Property="BorderBrush" Value="#B04A3F" />
        <Setter Property="Foreground" Value="#B04A3F" />
    </Style>
    <Style Selector="TextBlock.dirty-indicator">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#A29886" />
    </Style>

    <Style Selector="Border.editor-settings-panel">
        <Setter Property="Width" Value="316" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#E8E0D0" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="TabControl.editor-tabs">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#E8E0D0" />
    </Style>
    <Style Selector="TabControl.editor-tabs TabItem">
        <Setter Property="Width" Value="63" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#A29886" />
        <Setter Property="Padding" Value="0,7,0,9" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TabControl.editor-tabs TabItem:selected">
        <Setter Property="Foreground" Value="#B04A3F" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Path.editor-tab-glyph">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stroke" Value="{DynamicResource ZitieInkMutedBrush}" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="TabControl.editor-tabs TabItem:selected Path.editor-tab-glyph">
        <Setter Property="Stroke" Value="{DynamicResource ZitieAccentBrush}" />
    </Style>
    <Style Selector="StackPanel.editor-tab-body">
        <Setter Property="Margin" Value="16,14,16,12" />
    </Style>
    <Style Selector="TextBlock.editor-label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#6E675D" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="TextBlock.editor-section-title">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#6E675D" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Border.editor-field">
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style Selector="TextBox.editor-input">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="#FDFCF9" />
        <Setter Property="BorderBrush" Value="#D9CFBA" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBox.editor-input:focus">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#B04A3F" />
    </Style>
    <Style Selector="ComboBox.editor-input">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="#FDFCF9" />
        <Setter Property="BorderBrush" Value="#D9CFBA" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ComboBox.editor-input:focus">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#B04A3F" />
    </Style>
    <Style Selector="NumericUpDown.editor-input">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="#FDFCF9" />
        <Setter Property="BorderBrush" Value="#D9CFBA" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="NumericUpDown.editor-input:focus">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#B04A3F" />
    </Style>
    <Style Selector="Border.field-badge">
        <Setter Property="Background" Value="#F5F0E6" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style Selector="Border.field-badge TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="#A29886" />
    </Style>
    <Style Selector="CheckBox.editor-check">
        <Setter Property="Foreground" Value="#6E675D" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="CheckBox.editor-check:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource ZitieAccentBrush}" />
    </Style>
    <Style Selector="Slider.editor-slider">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.preview-stage">
        <Setter Property="Background" Value="#EDE6D6" />
    </Style>
    <Style Selector="Border.stage-bar">
        <Setter Property="Height" Value="46" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="#B3FBF8F1" />
        <Setter Property="BorderBrush" Value="#E8E0D0" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="Border.editor-status-bar">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0,0,14,0" />
        <Setter Property="Background" Value="#FBF8F1" />
        <Setter Property="BorderBrush" Value="#E8E0D0" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="TextBlock.status-text">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="#A29886" />
    </Style>
    <Style Selector="TextBlock.status-path">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#A29886" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="MaxWidth" Value="420" />
    </Style>
    <Style Selector="Border.status-dot">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Background" Value="#7BA05B" />
        <Setter Property="Margin" Value="14,0,8,0" />
    </Style>
    <Style Selector="TextBlock.muted-text">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#A29886" />
    </Style>
    <Style Selector="Border.log-panel">
        <Setter Property="Height" Value="240" />
        <Setter Property="Background" Value="#FBF8F1" />
        <Setter Property="BorderBrush" Value="#E8E0D0" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
</Styles>
