<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ApplicationIcon>..\..\logo.ico</ApplicationIcon>
    <!-- NativeAOT：仅 Windows 目标启用（配合 Roots.xml 保留反射所需程序集）；mac/Linux 用常规单文件 -->
    <PublishAot Condition="'$(TargetFramework)' == 'net10.0-windows'">true</PublishAot>
    <PublishTrimmed Condition="'$(TargetFramework)' == 'net10.0-windows'">true</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CodeWF.Toolkit.Core" />
    <TrimmerRootDescriptor Include="Roots.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Semi.Avalonia" />
    <PackageReference Include="Irihi.Ursa" />
    <PackageReference Include="Irihi.Ursa.Themes.Semi" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="hyjiacan.pinyin4net" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="JiebaNet.Segmenter.Net6" />
    <PackageReference Include="Prism.DryIoc.Avalonia" />
    <PackageReference Include="ReactiveUI" />
    <PackageReference Include="System.Reactive" />
    <PackageReference Include="CodeWF.Avalonia.Log" />
    <PackageReference Include="VC-LTL" Condition="'$(OS)' == 'Windows_NT'" />
    <PackageReference Include="YY-Thunks" Condition="'$(OS)' == 'Windows_NT'" />
    <PackageDownload Include="jieba.NET" Version="[$(JiebaNetResourcePackageVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zitie.Avalonia\Zitie.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zitie.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\logo.png" Link="Assets\logo.png" />
    <AvaloniaResource Include="..\..\logo.ico" Link="Assets\logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\resources\modules\**\*"
          Link="resources\modules\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never" />
    <None Include="..\..\resources\module-styles\styles.json"
          Link="resources\module-styles\styles.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\docs\modules\*.*"
          Link="resources\module-styles\images\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)jieba.net\$(JiebaNetResourcePackageVersion)\Resources\**\*.*"
          Link="Resources\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\resources\texts\**\*.md"
          Link="resources\texts\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\resources\pinyin\*.yml"
          Link="resources\pinyin\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\resources\strokes\*.*"
          Link="resources\strokes\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\resources\textbooks\*.yml"
          Link="resources\textbooks\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
