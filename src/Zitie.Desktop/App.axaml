<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="Zitie.Desktop.App"
             RequestedThemeVariant="Light">
    <Application.Resources>
        <FontFamily x:Key="ZitieUiFontFamily">avares://Zitie.Avalonia/Fonts#LXGW WenKai</FontFamily>
        <x:Double x:Key="ZitieUiFontSizeMicro">8</x:Double>
        <x:Double x:Key="ZitieUiFontSizeTiny">11</x:Double>
        <x:Double x:Key="ZitieUiFontSizeSmall">12</x:Double>
        <x:Double x:Key="ZitieUiFontSizeBase">13</x:Double>
        <x:Double x:Key="ZitieUiFontSizeMedium">14</x:Double>
        <x:Double x:Key="ZitieUiFontSizeLarge">14.5</x:Double>
        <x:Double x:Key="ZitieUiFontSizeTitle">26</x:Double>
        <x:Double x:Key="ZitieUiFontSizeSeal">22</x:Double>
    </Application.Resources>

    <Application.Styles>
        <semi:SemiTheme Locale="zh-CN" />
        <semi:UrsaSemiTheme Locale="zh-CN" />
        <StyleInclude Source="avares://Zitie.Avalonia/Themes/Index.axaml" />
        <StyleInclude Source="/Themes/Index.axaml" />
    </Application.Styles>
</Application>
