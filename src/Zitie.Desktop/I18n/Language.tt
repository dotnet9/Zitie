<#@ template hostspecific="true" language="C#" #>
<#@ assembly name="System.Text.Json" #>
<#@ assembly name="System.Runtime" #>
<#@ assembly name="System.Memory" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Text.Json" #>
<#@ output extension=".cs" #>
// <auto-generated>
// 根据宿主 JSON 生成；修改资源后运行 scripts/sync_localization_keys.ps1。
// </auto-generated>
namespace Zitie.Desktop.I18n;

public static class Language
{
<#
using var document = JsonDocument.Parse(File.ReadAllText(Path.Combine(Path.GetDirectoryName(Host.TemplateFile), "zh-CN.json")));
foreach (var property in document.RootElement.GetProperty("Zitie").GetProperty("Text").EnumerateObject())
{
#>
    public const string <#= property.Name #> = "Zitie.Text.<#= property.Name #>";
<#
}
#>
}
