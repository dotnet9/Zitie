<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>true</CentralPackageVersionOverrideEnabled>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <JiebaNetResourcePackageVersion>0.42.2</JiebaNetResourcePackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avalonia -->
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.1" />
    <!-- 渲染 -->
    <PackageVersion Include="SkiaSharp" Version="4.151.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="4.151.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.151.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.macOS" Version="4.151.1" />
    <PackageVersion Include="Svg.Skia" Version="5.2.1" />
    <!-- 主题与控件 -->
    <PackageVersion Include="Semi.Avalonia" Version="12.1.0.1" />
    <PackageVersion Include="Irihi.Ursa" Version="2.2.0" />
    <PackageVersion Include="Irihi.Ursa.Themes.Semi" Version="2.2.0" />
    <!-- MVVM / DI / 日志 -->
    <PackageVersion Include="CodeWF.Log.Avalonia" Version="12.1.1.3" />
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <PackageVersion Include="Prism.Avalonia" Version="8.1.97.11073" />
    <PackageVersion Include="Prism.DryIoc.Avalonia" Version="8.1.97.11073" />
    <PackageVersion Include="ReactiveUI" Version="24.1.0" />
    <PackageVersion Include="System.Reactive" Version="7.0.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="hyjiacan.pinyin4net" Version="4.1.1" />
    <!-- 中文分词：Net6 包负责运行时代码，官方 jieba.NET 只用于复制词典 Resources。 -->
    <PackageVersion Include="JiebaNet.Segmenter.Net6" Version="6.42.2" />
    <!-- 旧系统兼容（仅 Windows） -->
    <PackageVersion Include="VC-LTL" Version="5.3.1" />
    <PackageVersion Include="YY-Thunks" Version="1.2.2" />
    <!-- 测试 -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!-- 传递依赖钉版（消除旧版漏洞告警） -->
    <PackageVersion Include="System.Drawing.Common" Version="10.0.10" />
  </ItemGroup>
</Project>
